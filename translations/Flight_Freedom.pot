#. [scenario]: id=Citadel
#. [event]: id=apprentice_1, id=apprentice_2, id=apprentice_3, id=apprentice_4
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:19
#: Flight_Freedom/scenarios/04b_Forest_of_Nightmares.cfg:88
#: Flight_Freedom/scenarios/05b_Mogradesh.cfg:214
#: Flight_Freedom/scenarios/06b_The_Crypt_of_the_Mountains.cfg:305
#: Flight_Freedom/scenarios/06b_The_Crypt_of_the_Mountains.cfg:450
#: Flight_Freedom/scenarios/06b_The_Crypt_of_the_Mountains.cfg:564
#: Flight_Freedom/scenarios/06b_The_Crypt_of_the_Mountains.cfg:82
#: Flight_Freedom/scenarios/07b_The_Obsidian_Citadel.cfg:546
#: Flight_Freedom/scenarios/07b_The_Obsidian_Citadel.cfg:752
#: Flight_Freedom/scenarios/07b_The_Obsidian_Citadel.cfg:68
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:363
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:756
msgid "Death of Hartholar"
msgstr ""

#. [side]: type=Drake Chieftain, id=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:41
msgid "Hartholar"
msgstr ""

#. [side]: type=Drake Chieftain, id=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:51
msgid "Jamolar Flight"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:169
msgid ""
"Hmm... so Hartholar now wears the Dominant's robes.\n"
"He is a bigot but a wise drake nonetheless.\n"
"And the Jamolar Flight is mightier than ever before.\n"
"Even in these swamps."
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:176
msgid ""
"You!\n"
"Alien drake!\n"
"Leave now, or face immolation!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:182
msgid ""
"I am Malakar of the north.\n"
"Our lands have been overrun by conquering humans!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:187
msgid ""
"Leave, disgusting whelp.\n"
"You are of the race of Stakron, the betrayer of Kahn the mighty!\n"
"Perhaps that is why humans have attacked you!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:193
msgid ""
"No.\n"
"Not even humans punish children for the sins of their forefathers, unlike you.\n"
"They seek our blood, and this island for themselves!\n"
"They murdered my daughter!"
msgstr ""

#. [message]: speaker=Hartholar
#. 'wench' here is intended as a fairly mild gender-specific insult, not to literally mean 'prostitute':
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:201
msgid ""
"Oh, Necolag, that wench.\n"
"When the humans come, I shall thank them.\n"
"\n"
"Drakes!\n"
"To arms, let us drive out these rabble!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:209
msgid ""
"I shall not strike you down, Dominant Hartholar.\n"
"However we will defend ourselves and maintain our honor!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:215
msgid "NOTE: The campaign will not end if Hartholar is killed."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:248
msgid "Hisssss.....! Attack themmmm.....!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:252
msgid ""
"Saurians!\n"
"You have no part in this madness.\n"
"The humans are our common enemy!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:258
msgid ""
"These saurians are sworn to my service!\n"
"You cannot stand against them!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:267
msgid ""
"Hartholar!\n"
"End these games!\n"
"As we fight, the humans approach!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:274
msgid "Hartholar does not respond."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:283
msgid ""
"Enough!\n"
"Hartholar, surrender at once!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:306
msgid ""
"Stay your hand!\n"
"We do not have the Right of Assassination!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:322
msgid "Die, foul one!"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:340
msgid ""
"Kakatars!\n"
"These are our swamps.\n"
"You are not welcome here!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:385
msgid ""
"I shall kill Hartholar, for the good of the flight!\n"
"\n"
"Malakar, do not try to stop me.\n"
"I understand that you are bound by honor to spare our vile enemy.\n"
"But I shall do what must be done!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:393
msgid ""
"Loyal kin!\n"
"Kill the traitor, before he kills Hartholar!"
msgstr ""

#. [message]: speaker=second_unit
#. this is supposed to be sarcastic:
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:407
msgid ""
"For Malakar, the honorable!\n"
"So honorable that he cannot even strike down his enemies!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:420
msgid ""
"The Jamolar Flight is shattered and my honor blackened!\n"
"None will stand with me now!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:492
msgid ""
"Hartholar!\n"
"There, to the north, are the humans' scouts!\n"
"All hope is lost!\n"
"As Dominant, I shall face the hordes in single combat."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:499
msgid ""
"Hartholar, you are bound by this sacrifice to accept my people into your flight.\n"
"Perhaps your combined strength can succeed where ours has failed."
msgstr ""

#. [then]: type=Drake Priest, id=Morlin Ka
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:513
msgid "Morlin Ka"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:525
msgid ""
"The Kakatar Dominant speaks true!\n"
"Our fighting in the face of a greater enemy is a dishonor to Gar-Alagar himself!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:530
msgid ""
"Stay, warrior-chief!\n"
"\n"
"This sacrifice... I see that you are free of Stakron's taint.\n"
"Forgive me, Malakar, I have done you a great wrong.\n"
"I pledge myself and my flight to your service, upon my honor."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:538
msgid "Then we must plan our resistance!"
msgstr ""

