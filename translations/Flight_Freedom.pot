#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:177
#: Flight_Freedom/scenarios/17a_Blockade.cfg:46
#: Flight_Freedom/scenarios/17a_Blockade.cfg:72
msgid "Nagas"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:344
msgid "Caves as far as the eye can see. We are completely lost."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:348
msgid ""
"We must flee to somewhere.\n"
"Start looking for an exit."
msgstr ""

#. [message]: speaker=Theracar
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:358
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:366
msgid "But there are dwarves everywhere!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:372
msgid ""
"We do not have the time or the strength to fight with the half-men.\n"
"Avoid them if possible.\n"
"Kill any who pose a serious threat.\n"
"Go!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:380
msgid "NOTE: Undo is disabled for the duration of this scenario."
msgstr ""

