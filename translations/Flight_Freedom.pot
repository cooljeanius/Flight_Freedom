#. [then]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:384
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:441
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:589
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:611
msgid "Find a way out of the caverns"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:385
msgid "Explore the surrounding area"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:401
msgid "The humans pursue us!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:428
msgid "Well, we can't go back that way."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:432
msgid "At least the rubble will delay the humans for a little while."
msgstr ""

#. [then]
#. [event]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:442
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:590
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:612
msgid "<s>Explore the surrounding area</s>"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:443
msgid "Explore to the south"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:479
msgid "Sounds of battle echo through the tunnels."
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:533
msgid "A spider web!"
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:537
msgid "GUGGAGUGGAGU!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:552
msgid "A river of lava! How am I supposed to cross?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:556
msgid ""
"I shall take care of that later.\n"
"Drakes!\n"
"We need to explore this river!"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:580
msgid ""
"The river is full of monsters!\n"
"We cannot go East!"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:581
msgid "The river is full of monsters! We can't go East!"
msgstr ""

#. [else]
