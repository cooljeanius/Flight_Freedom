msgstr ""

#. [unit_type]: id=Drake Slave, race=drake
#: Flight_Freedom/units/drakes/Slave.cfg:21
msgid "Drake Slaves are servile members of this reptilian race."
msgstr ""

#. [variation]: id=Drake Slave, race=drake
#: Flight_Freedom/units/drakes/Slave.cfg:79
