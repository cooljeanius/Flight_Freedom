#: Flight_Freedom/scenarios/03a_The_Manor.cfg:57
msgid "Donoaov"
msgstr ""

#. [side]: type=Swordsman, id=Donoaov
#: Flight_Freedom/scenarios/03a_The_Manor.cfg:65
msgid "Prax's Bodyguard"
msgstr ""

#. [scenario]: id=Manor, id=A key
