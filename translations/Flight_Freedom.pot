#: Flight_Freedom/scenarios/11b_Solkans_Lair.cfg:1337
msgid "Destroy the colored orbs"
msgstr ""

#. [else]
#: Flight_Freedom/scenarios/11b_Solkans_Lair.cfg:1350
msgid "Explore the underground complex"
msgstr ""

#. [message]: id=Malakar
#: Flight_Freedom/scenarios/11b_Solkans_Lair.cfg:1375
msgid "I must find a way to free the flight before I leave!"
msgstr ""

#. [scenario]: id=Rockfall
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:4
msgid "Rockfall"
msgstr ""

#. [side]: type=Dwarvish Lord, id=Aigaithing
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:49
msgid "Aigaithing"
msgstr ""

#. [side]: type=Dwarvish Lord, id=Gomgaotilo
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:69
msgid "Gomgaotilo"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:210
msgid "In fact, I feel stronger than ever!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:220
msgid ""
"Hold!\n"
"I feel something!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:225
msgid ""
"I feel only the blasting heat of the lava.\n"
"It fills my veins!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:232
msgid "This heat! I can't stand this much longer."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:236
msgid ""
"The heat, yes, but... there!\n"
"The air... we must be near the exit!"
msgstr ""

#. [event]
#. [then]
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:244
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:340
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:403
msgid "Exit the cave"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:261
msgid "Strap on your thickest boots, boys! The invaders are stuck in the lava pool and it's time to take back what's ours!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:263
msgid "We are only trying to leave!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:263
msgid "We're just trying to leave!"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:272
msgid "Beards! Drakes, then elves, now drakes again! Why can't you all leave us alone?"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:276
msgid "We seek only to leave."
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:280
msgid "Be that as it may, you're tearing up our tunnels and profaning our land by dragging the ding-blasted elves everywhere."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:284
msgid "They pursue us still?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:290
msgid "Look. Buddy."
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:294
msgid "You're riding a drake?!?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:298
msgid "*growl*"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:304
msgid "Not... really. Where's the exit?"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:308
msgid "We cannot let you pass that way. Those tunnels are too fragile, and you have proven yourselves to be a menace. This is the end, lizards."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:324
msgid ""
"The roof of the tunnel is extremely low here.\n"
"It appears to be supported only by these boulders."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:331
msgid "We can strand the elves here for days if we can bring down the tunnel!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:335
msgid ""
"So be it.\n"
"This is our chance to leave our pursuers behind."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:341
msgid "Collapse the cave exit by destroying the six boulders that support it"
msgstr ""

#: Flight_Freedom/scenarios/12a_Rockfall.cfg:361
msgid "1 turn left to escape the cave-in!"
msgid_plural "$temp_turns_var turns left to escape the cave-in!"
msgstr[0] ""
msgstr[1] ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:386
msgid "All 6 boulders have been destroyed! The cave could collapse at any time! Everyone out, now!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:395
msgid "Malakar has $turns_to_escape turns to escape the cave-in."
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:406
msgid "Cave collapses"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:457
msgid "The roof's cracking! Hurry!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:472
msgid "This is our last chance to make it out!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:516
msgid "Uh, Mal? If we leave the tunnel open, the elves and humans will hound us into the ocean."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:562
msgid "Wow, and we made it out with time to spare, too!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:589
msgid "You've doomed us all..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:612
msgid ""
"No!\n"
"The exit is collapsing!\n"
"We are trapped!"
msgstr ""

#. [scenario]: id=Betrayal
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:4
msgid "Betrayal"
msgstr ""

#. [side]: type=Drake Burner, id=evil_Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:53
msgid "Kakatar Rebels"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:124
msgid "Mal? We're missing $gold gold."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:128
msgid "Defeat Theracar"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:145
msgid ""
"Drakes!\n"
"See how the softskin hastens to spill our blood!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:150
msgid "I've put down mutineers before. You're next!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:158
msgid ""
"No more should die under your command, Malakar!\n"
"\n"
"Drakes!\n"
"I offer you the hope of a brighter future!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:169
msgid ""
"Every drake that dies today is another blow to our flight!\n"
"\n"
"Surrender, Theracar.\n"
"Your death shall be swift and merciful."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:176
msgid "Never!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:184
msgid ""
"Every minute we fight each other is another step closer our pursuers approach!\n"
"We must end this quickly!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:199
msgid ""
"Kogw!\n"
"Your pirates have been no better than our old masters in Wesnoth!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:204
msgid "My men have bled and died for your tribe. I know I've been a scoundrel, so I don't care much what you call me. But do not DARE to dishonor my sailors!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:218
msgid "Down with Malakar!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:230
msgid ""
"Theracar, abandon this folly!\n"
"I once opposed Malakar.\n"
"I have long since come to trust in his leadership!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:236
msgid ""
"You forsook your flight.\n"
"You will receive a traitor's due along with Malakar!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:249
msgid ""
"Once again drakes raise their claws against each other!\n"
"I command this to end!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:254
msgid "It is Theracar who has raised his claws against me!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:258
msgid ""
"Pick a side, priest.\n"
"A brighter future tomorrow, or suffer and rot today!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:263
msgid ""
"I shall salve your wounds.\n"
"But I shall not join you in dishonor.\n"
"I shall not bear my staff against another drake this day!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:351
msgid "I bring you justice!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:364
msgid ""
"Lay down your weapons!\n"
"The traitor has fallen!"
msgstr ""

#. [message]: role=remorse
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:376
msgid "Malakar, Dominant..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:380
msgid ""
"What has happened here today will forever be a black mark upon our flight.\n"
"\n"
"Those who will swear allegiance to me and to the flight are hereby pardoned.\n"
"Those who will not must leave behind their weapons and go their separate ways."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:387
msgid ""
"Theracar's complaints were just though his methods were unforgivable.\n"
"There have been hard times for us all.\n"
"We have all suffered much.\n"
"Tonight we will hold a forum to discuss the future of our flight.\n"
"But for now we must put as much distance as we can between ourselves and the ruins of the cave mouth."
msgstr ""

#. [message]: role=maddrake
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:403
msgid ""
"Malakar, with respect, these drakes have spilled our flight's blood.\n"
"Surely you cannot..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:408
msgid ""
"All are pardoned.\n"
"\n"
"None of you will ever forget the sides that were chosen here today.\n"
"But any who are found telling the hatchlings, or accusing your neighbors of old treasons, will face the harshest penalties.\n"
"\n"
"We must live again as a flight if we are to survive.\n"
"MOVE OUT!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/13a_Betrayal.cfg:499
msgid ""
"We have lost too many!\n"
"Even if I win this fight, the flight cannot continue!"
msgstr ""

#. [scenario]: id=Hordes_Undead
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:4
msgid "Hordes of the Foul Undead"
msgstr ""

#. [side]: type=Lich, id=Gul-Nana, gender=female
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:44
msgid "Gul-Nana"
msgstr ""

#. [side]: type=Lich, id=Gala-Thano
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:59
msgid "Gala-Thano"
msgstr ""

#. [scenario]: id=Hordes_Undead
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:78
msgid "Move Malakar to the ruined keep"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:127
msgid "After defeating the rebels, the remaining Kakatars left the valley. The gliders soon began reporting salt on the breeze: the ocean couldn't be far off."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:133
msgid "Mal! Mal!"
msgstr ""

#. [message]: speaker=Malakar
#. case matters here; Malakar is emphasizing the part of his name Kogw left out:
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:138
msgid "MalAKAR, Kogw, Malakar."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:142
msgid "Yes, great! I just spoke with a scout and..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:146
msgid "The scouts do not report to you!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:150
msgid "He was wounded and I'd be faster; but we've got trouble!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:154
msgid "The humans?"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:158
msgid "The Gate of Storms, Mal, the Gate! This half of the island is crawling with undead!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:162
msgid ""
"We can rally the flight at the ruined fortress!\n"
"Go!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:170
msgid "After escaping the magical trap, the remaining Kakatars left the valley. The gliders soon began reporting salt on the breeze: the ocean couldn't be far off."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:176
msgid ""
"Now we must find a way off of this island.\n"
"\n"
"Perhaps we will be able to find passage at the coast.\n"
"If need be we could seek other islands between here and Morogor that we can fly to."
msgstr ""

#. [message]: role=glidera
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:214
msgid ""
"Dominant!\n"
"This half of the island is crawling with undead!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:219
msgid ""
"The humans must have stooped to necromancy!\n"
"We must tread carefully."
msgstr ""

#. [message]: speaker=Malakar
#. Malakar catches himself before finishing "read about"
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:231
msgid ""
"Or perhaps this is the Gate I read... the pirate spoke of.\n"
"We must reach the ruined fortress and rally the flight!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:238
msgid ""
"Or perhaps this is the Gate the pirate spoke of.\n"
"We must reach the ruined fortress and rally the flight!"
msgstr ""

#. [message]: id=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:283
msgid "They seem to fight with statues."
msgstr ""

#. [message]: id=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:287
msgid "I've heard stories of them; step carefully, this is powerful black magic."
msgstr ""

#. [message]: id=Theracar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:291
msgid ""
"I recall rumors of them from my time serving that wretched Baron.\n"
"This is powerful black magic."
msgstr ""

#. [unit]: type=Arch Mage, id=Elealonna, gender=female
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:317
msgid "Elealonna"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:331
msgid "Mercy! Mercy!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:333
msgid "Give me one reason not to kill you, human."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:333
msgid "Who goes there?"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:336
msgid "I am... was... the Mage-Advisor to this expedition. I think I'm the only one left, but I'm old... so old..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:340
msgid ""
"Human.\n"
"Tell me what happened.\n"
"Speak!"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:346
msgid "There was an earthquake. Then a purple fog rippling across the land, the air suddenly thick with dark magic. Then everyone started to age. I just can't stop thinking about it... the boyish soldiers' faces sprouting lifetimes of wrinkles in but moments... vibrant locks of hair graying and falling out before my eyes... I cast a barrier charm as fast as I could but it was too late to save my vitality."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:350
msgid "And then everyone, wracked in agony, began to die. Flesh rotting and sloughing off as if it were but drool, bones and sinew bleaching in an instant..."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:354
msgid "I ran as fast... or slow... as my now aching, weak knees could carry me, when the rattling began. Skeletons, monsters, and worse standing up and once more taking up their weapons. I slipped away as the fog began to dissipate. I've been hiding in this army tent since. Desperately waiting for a chance to go somewhere... anywhere besides this cursed place."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:358
msgid "The cave-in, it must have woken the Gate!"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:362
msgid "Now I am old... so, so old... my magic is diminished but not yet faded. Yes... I still have that spark in my mind. I'll lend my staff to your service against these undead... even those who were once my friends when they yet lived. Will you have me?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:372
msgid ""
"You came with your army to this island, across the ocean, to cast us once again into slavery.\n"
"Perhaps unlife was a fitting punishment for your crimes.\n"
"I should send you to join your fellow thinskins in death."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:378
msgid "But Mal, the Gate is a true evil! This black magic threatens us all, and she can help us!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:382
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:410
msgid ""
"Or perhaps she is behind this.\n"
"\n"
"The humans have proven they will stop at nothing to hunt us down.\n"
"How suspicious that she is the only human here.\n"
"And a wizard no less."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:397
msgid ""
"You came with your army to this island, across the ocean, to cast us once again into slavery.\n"
"\n"
"Perhaps unlife was a fitting punishment for your crimes.\n"
"I should send you to join your fellow thinskins in death."
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:404
msgid ""
"Malakar!\n"
"She may be a human.\n"
"But the undead are a greater evil!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:421
msgid ""
"Malakar, we must consider that the thinskins could be anywhere.\n"
"I propose that we dispense of this one.\n"
"We should leave the thinskins and the undead to fight each other!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:427
msgid ""
"Human.\n"
"You came with your army to this island, across the ocean, to cast us once again into slavery.\n"
"Perhaps unlife was a fitting punishment for your crimes.\n"
"I should send you to join your fellow thinskins in death.\n"
"But perhaps you could find a scrap of honor and be useful to us."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:437
msgid "The undead are closing in... I pledge myself to your service, but if you wish to kill me... just be quick about it..."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:439
msgid "Spare her."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:443
msgid ""
"You may live.\n"
"But give even the slightest hint of betrayal and you will wish you were among the undead."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:460
msgid "Kill her."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:471
msgid "Malakar, please! You ask me to kill her in cold blood!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:475
msgid ""
"I do not ask.\n"
"I am your Dominant!\n"
"I command you to kill her!\n"
"She cannot be trusted."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:482
msgid "Arr... so be it. I'm sorry, lass."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:516
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:714
msgid "And so it ends... grant final rest to my companions, I beg you..."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:538
msgid "Thano... my love... I can only hope you now find peace in the hereafter..."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:549
msgid "Nana... my apprentice... I failed you, I'm so sorry..."
msgstr ""

#. [message]: speaker=Elealonna
#. probably won't be reached, but the enemies can recruit Dark Adepts who could theoretically also advance to Liches:
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:558
msgid "Seeing my fellow magi turning to darkness and lichdom... it pains my heart."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:569
msgid "The undead are growing too powerful! We cannot prevail!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:573
msgid ""
"The undead are growing too powerful!\n"
"We cannot prevail!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/14_Hordes_of_the_Foul_Undead.cfg:586
msgid ""
"The undead are weakening.\n"
"We must move on before they regroup!"
msgstr ""

#. [label]
#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:96
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:4
msgid "Gate of Storms"
msgstr ""

#. [side]: id=s15_undead_leader, type=Lich, type=Ancient Lich
#. [side]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:54
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:91
msgid "Gate Guardians"
msgstr ""

#. [then]
#. [event]
#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:669
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:732
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:100
msgid "Destroy the Gate of Storms"
msgstr ""

#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:101
msgid "Move a unit onto the Gate of Storms"
msgstr ""

#. [unit]: type=Major Spirit, id=Thromor
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:185
msgid "Thromor"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:239
msgid "There, beyond that castle! This is the Gate of Storms!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:243
msgid ""
"I want three scouts sent south and east.\n"
"Find a safe path past the Gate.\n"
"Hopefully, it will distract and slow any who would follow us."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:249
msgid "With respect, Malakar, the Gate is open. It probably doesn't matter what we do - in time, this island, Wesnoth and all of Morogor will be overrun and destroyed. You can run to the ends of the world, and rotting corpses will still hound your steps..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:254
msgid "*<i>growls</i>*"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:258
msgid "...never sleeping, never stopping, never tiring, hungering only for blood..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:262
msgid ""
"I have new orders.\n"
"I want any available scouts to investigate the Gate.\n"
"We will see if it has a weakness.\n"
"Then attempt to shut it before moving on."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:271
msgid ""
"There, beyond that castle!\n"
"This must be the Gate of Storms!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:276
msgid ""
"I want three scouts sent south and east.\n"
"Hopefully, we can slip past the Gate.\n"
"The undead will distract and slow any who would follow us."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:282
msgid ""
"The undead are seemingly without number.\n"
"The thunder spirits have not ceased to assail us.\n"
"\n"
"I fear that there is no safe path.\n"
"Our only hope of escape is to destroy the Gate!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:290
msgid ""
"Your counsel is wise, First Intendant.\n"
"\n"
"I have new orders.\n"
"I want any available scouts to investigate the Gate.\n"
"We will see if it has a weakness.\n"
"Then attempt to shut it before moving on."
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:310
msgid ""
"This gate is an abomination!\n"
"Gar-Alagar wills its destruction.\n"
"Forward, drakes!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:366
msgid "Join us... bring death to the humans... bring death to ALL!"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:372
msgid "I! Am! MALAKAR! And I reject your evil!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:378
msgid "Death shall find you... in the end..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:382
msgid ""
"Then I shall live on in the memory of my flight.\n"
"Begone!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:394
msgid "Malakar gains the Fearless trait!"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:400
msgid "I... I must submit... I surrender to you..."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:424
msgid "Then enter... embrace the End of all things!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:521
msgid "Mal, what have you done???"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:525
msgid ""
"Malakar...\n"
"You have betrayed the flight and I shall strike you down!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:530
msgid "END."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:649
msgid "The arcane energy density is too high, I cannot get close enough to touch the gate! Physical force will be worthless here!"
msgstr ""

#. [else]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:653
msgid ""
"Such... strange... power.\n"
"I cannot get close enough to touch the gate.\n"
"Physical force is worthless here!"
msgstr ""

#. [else]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:655
msgid "Such... strange... power. I cannot get close enough to touch the gate. Physical force is worthless here!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:660
msgid ""
"The spirits are redoubling their efforts!\n"
"\n"
"I need any remaining Burners to surround the Gate.\n"
"Get as close as you can and set it ablaze!\n"
"Everyone else, cover for them."
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:670
msgid "Move a Drake Burner, Fire Drake, Inferno Drake, or Armageddon Drake onto the Gate of Storms"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:679
msgid "A Fire, Inferno or Armageddon Drake is necessary to destroy the Gate of Storms."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:694
msgid "I... I feel a coldness, a terrible, crushing coldness in my chest... I fear my time is coming to a close..."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:728
msgid ""
"My fire is too weak.\n"
"We need a stronger firebreather!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:733
msgid "Move a Fire, Inferno or Armageddon Drake onto the Gate of Storms"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:748
msgid "I call upon Gar-Hagar, god of all that is burning and favored child of Gar-Alagar, to destroy this portal of evil!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:772
msgid "Wow, that was quite the fiery display! I just wonder if it could have been even more fiery..."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:776
msgid ""
"The portal seems to have closed.\n"
"We must hope it remains closed for the foreseeable future...\n"
"Perhaps with a hotter flame."
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:789
msgid "Noble drakes... you have my gratitude. Now I can die in peace..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:819
msgid ""
"The Gate is still open!\n"
"Close it quickly before any more monsters come through!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:832
msgid "I feel a growing sensation of evil. As if the undead are growing stronger before our eyes!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:836
msgid ""
"I feel a growing sensation of evil.\n"
"As if the undead are growing stronger before our eyes!"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:848
msgid "Indeed the dark magic in the air thickens... we must stop the thaumic flow at its source... destabilize the planar vortex... asymmetric local perturbation of entropy should initiate cascading harmonic failure and interrupt transdimensional flux..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:852
msgid "Speak plainly, human!"
msgstr ""

#. [message]: speaker=Elealonna
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:856
msgid "Apologies... we must set the gate on fire... that should close it..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:862
msgid ""
"I too feel the undead menace growing.\n"
"We must close the gate quickly.\n"
"Onward!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:907
msgid "Focus on the gate!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1018
msgid ""
"The Gate...\n"
"It is glowing..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1081
msgid "Get... out... of... my... HEAD!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1089
msgid ""
"No...\n"
"These voices compel me...\n"
"Must obey...\n"
"No... no... NO!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1096
msgid ""
"Malakar, hold fast!\n"
"You must not let this evil overtake you!"
msgstr ""

#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1114
msgid "doom to all turn back TURN BACK nightmare of ending doom destruction desolation death DEATH to the world"
msgstr ""

#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1115
msgid "darkness awaits all YOU CANNOT PREVAIL failure despair empty death void hatred misery enmity black HATE"
msgstr ""

#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1116
msgid "evil will NOT BE DENIED all must die ALL MUST END torture PAIN agony terror suffering why fight the inevitable"
msgstr ""

#. [scenario]: id=Gate_Storms
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1117
msgid "all must die YOU WILL DIE DARKNESS OBLIVION give up GIVE UP ALL IS DEATH death awaits you DIE DIE DIE"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1136
msgid "Some sort of barrier is keeping me from approaching the lich!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:1225
msgid "We must destroy the Gate!"
msgstr ""

#. [scenario]: id=Exodus
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:4
msgid "The Exodus"
msgstr ""

#. [side]: type=Highwayman, id=Rhygwyn
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:43
msgid "Rhygwyn"
msgstr ""

#. [side]: type=Highwayman, id=Rhygwyn
#. [side]: type=Fugitive, id=Rhaedoc
#. [side]: type=Highwayman, id=Labryn
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:50
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:68
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:86
msgid "Wesnoth Army Deserters"
msgstr ""

#. [side]: type=Fugitive, id=Rhaedoc
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:61
msgid "Rhaedoc"
msgstr ""

#. [side]: type=Highwayman, id=Labryn
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:79
msgid "Labryn"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:130
msgid "A mere four days of travel later, the flight found themselves on familiar ground -- and Kogw found himself among familiar faces."
msgstr ""

#. [unit]: type=Pirate, gender=male, id=Rhys
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:145
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:307
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:511
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:885
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:946
msgid "Rhys"
msgstr ""

#. [unit]: type=Pirate, gender=male, id=Davies
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:172
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:333
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:526
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:879
msgid "Davies"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:189
msgid "Captain Kogw! Captain Kogw!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:193
msgid "Rhys?"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:197
msgid "You old scoundrel! How in blazes are you still alive?"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:201
msgid "You think a few measly warships could really stop the Unforgiver? We played 'possum until they were fully docked, then high-tailed it back North."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:205
msgid "North? Wouldn't a, y'know, daring rescue been more appropriate?"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:209
msgid "Well, that's what I said, but Davies, here..."
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:213
msgid "Leave me out of this, bilge-rat."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:217
msgid "Anyways, the wind blew us back and we've been circling the island since, trying to resupply without getting attacked."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:221
msgid "The Unforgiver is still in one piece? That's wonderful! We'll have the ocean's finest ride all the way to Morogor!"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:225
msgid "Yep, it's just off-shore to the northwest."
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:244
msgid "Surprising number of unfriendly-types around here. Real strange chaps too for army deserters; something's not right on this island."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:248
msgid "If it's supplies you need..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:252
msgid ""
"Drakes!\n"
"Clear the area of interference immediately.\n"
"We are leaving these cursed shores!"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:258
msgid "Speaking of which, I think I saw a skeleton last week. Craziest thing..."
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:262
msgid "Oh, and we've scraped together a few coins. We kind of figured we'd be using them to buy our way out of here, but as long as you're alive I suppose they're yours."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:273
msgid "Also, the village we were staying in is friendly."
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:282
msgid "Death of Rhys"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:283
msgid "Death of Davies"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:292
msgid "A mere four days of travel later, the flight found themselves on familiar ground."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:349
msgid "Drakes! Do you bring word of Kogw?"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:353
msgid ""
"Thinskin.\n"
"Tell me the way to Morogor."
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:358
msgid "Rhys, here, says that he's got a map. But first, tell us of our captain!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:362
msgid ""
"The captain is dead.\n"
"He was killed by the elves."
msgstr ""

#. [message]: speaker=s16_peasant
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:377
msgid "We all heard how the elves killed a pirate in the forest! Oh dearie... 'twas so horrible... I swear we could hear his screams for days..."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:381
msgid "And you drakes let him die!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:385
msgid ""
"Hand over the map now, thinskin.\n"
"Or you will join your captain.\n"
"Believe me, you would suffer far more burning alive by my flame than anything the pointy ears could do."
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:391
msgid "Rhys, let's go. We've scraped together a few coins, we can buy a way out of here with the deserters."
msgstr ""

#. [else]
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:427
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1014
msgid "Capture the pirates"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:553
msgid "Dominant, we have found the pirates!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:559
msgid ""
"The map.\n"
"Hand it over.\n"
"NOW!"
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:565
msgid "You betrayed my captain! I'll rip it to shreds it before I ever give it to you monsters!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:583
msgid "Drake, kill his companion."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:589
msgid "Kill his companion."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:638
msgid ""
"Listen to me well, thinskin.\n"
"\n"
"You have nowhere left to run.\n"
"You will not leave here alive.\n"
"Give us the map and your death will be swift.\n"
"Otherwise it will be... slow."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:648
msgid "I... I... h-h-here you go... t-t-take the map... please don't kill me... please don't kill me!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:652
msgid ""
"Very well.\n"
"Now stand and face your end!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:690
msgid ""
"This map points the way to Morogor!\n"
"Now we must drive away these stragglers so we can prepare to depart this cursed island."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:718
msgid "Oh no... on no!!!"
msgstr ""

#. [message]: speaker=Davies
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:786
msgid "Yo! We need passage off this island! We will pay you all that we have!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:790
msgid "That can be arranged... for the right price."
msgstr ""

#. [message]: speaker=Rhys
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:795
msgid "I trust this will be enough."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:799
msgid "Indeed so! Come on, lads. Let's get you two out of here."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:805
msgid ""
"No!\n"
"Without the map we will never find our way back home!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:836
msgid "No! Without my navigator, we cannot sail!"
msgstr ""

#. [message]: speaker=Davies
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:864
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:881
msgid "Hey, Rhys. I have a new guess about what's wrong with this island."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:887
msgid "Hopefully they still answer to gold..."
msgstr ""

#. [message]: speaker=Rhys
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:931
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:948
msgid "See! A skeleton! I told you so!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:971
msgid "No! Without my helmsman, we cannot sail!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1010
msgid ""
"We have slain the deserter leaders.\n"
"We must still track down the pirates and their map!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1056
msgid "The wind is dying down. We cannot sail away!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1067
msgid ""
"We are exhausted from the fighting...\n"
"We cannot fly against the winds!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1075
msgid ""
"We still have not found the map!\n"
"Doubtlessly the pirates have escaped.\n"
"We are stranded!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1097
msgid ""
"Drakes!\n"
"We have a hard flight ahead of us.\n"
"But our homeland beckons!\n"
"Today we shall gather our supplies.\n"
"We must build rafts to carry with us so we can rest during our journey.\n"
"Tomorrow we fly!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1108
msgid "To Morogor!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/16_The_Exodus.cfg:1118
msgid "Cap'n, glad to have you aboard again! It's a shame we couldn't kill more of these rabble..."
msgstr ""

#. [scenario]: id=Blockade, race=ship
#: Flight_Freedom/scenarios/17a_Blockade.cfg:4
msgid "Blockade"
msgstr ""

#. [side]: type=Naga Myrmidon, id=Abraxa
#: Flight_Freedom/scenarios/17a_Blockade.cfg:38
msgid "Abraxa"
msgstr ""

#. [side]: type=Merman Triton, id=Ikatere
#: Flight_Freedom/scenarios/17a_Blockade.cfg:92
msgid "Ikatere"
msgstr ""

#. [side]: type=Merman Triton, id=Ikatere
#: Flight_Freedom/scenarios/17a_Blockade.cfg:100
msgid "Mermen"
msgstr ""

#. [scenario]: id=Blockade, race=ship
#: Flight_Freedom/scenarios/17a_Blockade.cfg:120
msgid "Move the Unforgiver to the East"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:313
msgid "(Kogw) Rhys, here, says that he's got a map."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:318
msgid "(Davies) It was mostly my work."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:323
msgid "(Kogw) And if we go East here until the reefs, we can drop South and catch a strong current that should sweep us all the way back to Morogor, no problem."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:328
msgid "(Davies) Did you tell him about..."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:333
msgid "(Kogw) The only, uh, hitch is that the slightest disturbance is likely to start the Mermen and Nagas fighting again. They've both claimed this stretch for as long as anyone can remember, and they've sunk many ships in these waters."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:338
msgid ""
"(Malakar) We tread lightly, then.\n"
"Just get us home."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:354
msgid "(Kogw) All hands! Watch the depths!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:376
msgid "(Davies) Rhys, you idiot! You've navigated us straight into a naga attack!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:380
msgid "(Rhys) Someday we'll look back on this and laugh. For now, it gets even better: the mermen are massing for an attack, too."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:386
msgid "(Davies) Rhys, you idiot! You've navigated us straight into the mermen!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:390
msgid "(Rhys) Someday we'll look back on this and laugh. For now, it gets even better: the nagas are massing for an attack, too."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:397
msgid "(Kogw) Aye, I don't know why they're after us. Perhaps they hate all outsiders?"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:402
msgid ""
"(Malakar) Regardless, we will not be stopped.\n"
"See that we make it, Kogw."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:419
msgid "(Kogw) On to Morogor!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:550
msgid "(Malakar) The merman leader has fallen!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:555
msgid "(Kogw) Great. Mal, the nagas will want a chunk of our hulls now. It's certainly hard to find good wood anywhere else out here."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:562
msgid "(Malakar) The naga leader has fallen!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:567
msgid "(Kogw) Great. Mal, the mermen will want a chunk of our hulls now. It's certainly hard to find good wood anywhere else out here."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:578
msgid "(Malakar) The sea dwellers have been defeated!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:583
msgid "(Kogw) They've only been driven back. Quickly, we need to leave these waters! And be wary for any stragglers."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/17a_Blockade.cfg:625
msgid "(Kogw) No! The winds have subsided! We cannot sail further!"
msgstr ""

#. [scenario]: id=Parched_Sands
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:4
msgid "Parched Sands"
msgstr ""

#. [side]: type=Dune Luminary, id=Zakara
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:46
msgid "Zakara"
msgstr ""

#. [side]: type=Dune Luminary, id=Zakara
#. [side]: type=Dune Warmaster, id=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:53
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:67
msgid "Islanders"
msgstr ""

#. [side]: type=Dune Warmaster, id=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:60
msgid "Nibir al-Nassim"
msgstr ""

#. [side]
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:101
msgid "Birds"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:391
msgid ""
"Finally, dry land.\n"
"We cannot tarry here.\n"
"\n"
"Drakes!\n"
"Spread out and hunt - fill our bellies today and our rucksacks and waterskins for tomorrow!"
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:400
msgid "Scaled ones. You speak with Muqaddam Nibir al-Nassim, master of this island. If you have come to trade, you must register at the southeast docks. Otherwise you must leave at once!"
msgstr ""

#. [message]: speaker=Zakara
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:404
msgid "The markets of Al-Zaiybah are open to all. Registration forms must be completed in triplicate. Tribute equivalent to one part of every three parts of precious metals in your possession is due at time of registration. My, my, your weapons and armor are truly fine in quality..."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:408
msgid ""
"Dominant, we do not have the time or the resources to pander to the thinskins' greed!\n"
"\n"
"If we trade we will have nothing left for the fight to reclaim our homeland."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:414
msgid ""
"Muqaddam.\n"
"We seek food and water.\n"
"Give us supplies and we will be on our way."
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:420
msgid "This is your last warning. I, Nibir al-Nassim, command you to pay tribute and trade or begone!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:424
msgid ""
"Then we will take what we need.\n"
"\n"
"Kakatars!\n"
"To arms!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:432
msgid "In this scenario your objective is to hunt sufficient food to sustain the flight to finish your journey to Morogor. Hunting animals and monsters grants food; $food_needed food is necessary to win."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:438
msgid "You may view how much food you have acquired at any time during your turn by right-clicking and selecting “Food...”"
msgstr ""

#. [set_menu_item]: id=show_food_table
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:444
msgid "Food..."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:452
msgid "Hunt animals and monsters for food"
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:498
msgid "My palace is under attack! I, Nibir al-Nassim, command all who are able to take up arms and fight!"
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:516
msgid "Look into my face, drake, and know that I, Nibir al-Nassim, shall be the one to end your life!"
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:532
msgid "All hail I, Nibir al-Nassim, the Drakeslayer!"
msgstr ""

#. [message]: speaker=Zakara
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:550
msgid "Such precious metals this lizard was wearing! These should fetch a princely sum indeed at the markets."
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:561
msgid "I, Nibir al-Nassim, am the strongest! I am the greatest! I am... I am..."
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:581
msgid "Food."
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:587
msgid "Dead."
msgstr ""

#. [message]: speaker=Zakara
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:600
msgid "No! My trading contracts, my riches, my fancy goods, all for naught!"
msgstr ""

#. [message]: speaker=second_unit
#. [message]: role=hungry_drake
#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:632
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:652
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:659
msgid ""
"So hungry...\n"
"I could even eat this thinskin..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:668
msgid ""
"Check yourself!\n"
"We will not sully ourselves with the meat of thinskins!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:673
msgid ""
"But Malakar, my Dominant, our flight is starving!\n"
"We need all the food we can carry.\n"
"Even long pig."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:681
msgid "We are better than the humans, and we always will be! We shall not defile their dead."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:686
msgid ""
"Very well, Dominant.\n"
"Just let us hope we find enough to eat in this sandy wasteland."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:692
msgid "The health of my flight must come before propriety. We shall feast on the flesh of our enemies this day!"
msgstr ""

#. [message]: role=angry_dune
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:706
msgid "The monsters are eating our dead!"
msgstr ""

#. [message]: speaker=Nibir_alNassim
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:710
msgid "Men of the dunes! The drakes have brought unspeakable evil to our island. Slaughter them all! Do not rest until every fiend is dead! I, Nibir al-Nassim, shall lead you to victory!"
msgstr ""

#. [command]
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:716
msgid "Hunt enemies for food"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:798
msgid ""
"We barely have scraps left to eat.\n"
"We need to find more food quickly or we will never make it to Morogor!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:807
msgid ""
"Our strength is spent here...\n"
"We cannot go on."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:816
msgid ""
"We have the food we need.\n"
"Malakar, let us plunder this island for ourselves!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:821
msgid ""
"No.\n"
"Every day we spend on this island is another day Morogor remains unguarded.\n"
"We fly onwards immediately!"
msgstr ""

#. [scenario]: id=Return_Morogor
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:4
msgid "Return to Morogor"
msgstr ""

#. [side]: type=Lieutenant, id=Yraec
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:49
msgid "Yraec"
msgstr ""

#. [side]: type=Lieutenant, id=Yraec
#. [side]: type=General, id=Careorra
#. [side]: type=Lieutenant, id=Lunnyn
#. [side]: type=General, id=Cicyn
#. [side]: type=Lieutenant, id=Yreddyn
#. [side]: type=Lieutenant, id=Rycyn
#. [side]: type=Lieutenant, id=Rheoran
#. [side]: type=Grand Marshal, id=Yrynyc
#. [side]: type=General, id=Rhyrraent
#. [side]: type=General, id=Lenvan
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:91
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:138
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:185
#: Flight_Freedom/scenarios/19_Liberation.cfg:77
#: Flight_Freedom/scenarios/19_Liberation.cfg:112
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:115
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:159
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:195
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:210
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:245
msgid "Wesnoth Occupation Force"
msgstr ""

#. [side]: type=General, id=Careorra
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:96
msgid "Careorra"
msgstr ""

#. [side]: type=Lieutenant, id=Lunnyn
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:143
msgid "Lunnyn"
msgstr ""

#. [side]
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:196
msgid "Drakish Rebels"
msgstr ""

#. [side]
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:225
msgid "Dunefolk Hunters"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:321
msgid ""
"This is grim news indeed.\n"
"How is it that you are here to tell me of this?"
msgstr ""

#. [message]: speaker=scout
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:326
msgid ""
"A small handful of rebels have been in hiding ever since the attack.\n"
"We have fought our battles when and where we can.\n"
"But our hopes are low.\n"
"Our numbers are dwindling.\n"
"Your arrival will mean a great deal."
msgstr ""

#. [message]: speaker=scout
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:334
msgid "I shall gather our leaders and meet you here at this beach as soon as I can."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:338
msgid "Godspeed."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:357
msgid "Mal, if they bring their leaders out in the open, they'll be slaughtered!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:361
msgid ""
"Malakar, we are too exposed here.\n"
"We cannot protect their leaders!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:366
msgid ""
"I know.\n"
"We will have the beaches cleared before they arrive."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:378
msgid "NOTE: From now on, since the Unforgiver is no longer critical to your cause, the game will not end if it is lost."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:396
msgid "No! My flagship!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:400
msgid ""
"You can mourn the boat another day.\n"
"For now we are trapped on this beach.\n"
"We prevail together this day or we both die."
msgstr ""

#. [message]: speaker=scout
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:419
msgid ""
"Word is being passed to the resistance.\n"
"I have come back to help you claim the beach."
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:479
msgid ""
"It is true!\n"
"The Kakatars have returned!"
msgstr ""

#. [message]: speaker=scout
#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:647
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:653
msgid "The entire island trembles!"
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:742
msgid "I HAVE RETURNED. I AM QUEMAR. HUMANS, I AM YOUR DOOM."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:752
msgid "Surely that big dragon fellow isn't talking about me? Right?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:756
msgid ""
"Quemar...\n"
"Perhaps the ritual was successful!"
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:761
msgid "MALAKAR OF THE KAKATAR FLIGHT. YOU STILL LIVE. TOGETHER WE SHALL CLEANSE MOROGOR OF THE PUNY THINSKINS."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:771
msgid ""
"Indeed, Quemar.\n"
"Except for the pirate.\n"
"He is an ally and a Kakatar.\n"
"He is under my protection."
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:778
msgid "VERY WELL. YOUR PET THINSKIN MAY LIVE. I WILL BE WATCHING YOU, HUMAN."
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:834
msgid "THUS SHALL BE THE FATE OF ALL HUMANS."
msgstr ""

#. [message]: speaker=dune_harrier
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:889
msgid "Kal, we have tracked down the drakes who ransacked Al-Zaiybah!"
msgstr ""

#. [message]: speaker=dune_leader
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:899
msgid "These monsters have eaten our kinsmen! They are worse than wild beasts. Put them down like the animals they are!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:914
msgid ""
"The rebel leaders are walking into enemy territory!\n"
"We have failed them!"
msgstr ""

#. [message]: speaker=scout
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:930
msgid "For a free Morogor!"
msgstr ""

#. [message]: speaker=scout
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:945
msgid ""
"Your rule is ending!\n"
"Morogor belongs to us drakes!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/18_Return_to_Morogor.cfg:964
#: Flight_Freedom/scenarios/19_Liberation.cfg:1416
msgid "We continue!"
msgstr ""

#. [scenario]: id=Liberation
#: Flight_Freedom/scenarios/19_Liberation.cfg:4
msgid "Liberation"
msgstr ""

#. [side]: type=General, id=Cicyn
#: Flight_Freedom/scenarios/19_Liberation.cfg:51
msgid "Cicyn"
msgstr ""

#. [side]: type=Lieutenant, id=Yreddyn
#: Flight_Freedom/scenarios/19_Liberation.cfg:83
msgid "Yreddyn"
msgstr ""

#. [side]
#: Flight_Freedom/scenarios/19_Liberation.cfg:125
msgid "Slave Guards"
msgstr ""

#. [side]: type=Drake Priest, id=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:147
msgid "Kamalar"
msgstr ""

#. [side]: type=Drake Priest, id=Kamalar
#. [modify_side]
#. [side]
#: Flight_Freedom/scenarios/19_Liberation.cfg:166
#: Flight_Freedom/scenarios/19_Liberation.cfg:922
#: Flight_Freedom/scenarios/19_Liberation.cfg:1010
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:69
msgid "Kamalar's Guard"
msgstr ""

#. [side]
#: Flight_Freedom/scenarios/19_Liberation.cfg:226
msgid "Drake Rebels"
msgstr ""

#. [scenario]: id=Liberation
#: Flight_Freedom/scenarios/19_Liberation.cfg:276
msgid "Liberate the mine"
msgstr ""

#. [set_menu_item]: id=control_slaves
#: Flight_Freedom/scenarios/19_Liberation.cfg:407
msgid "Manual control"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:473
msgid "Kamalar can take command of rebelling mine slaves during his turn. To do so, right-click on the slave and select “Manual control”."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/19_Liberation.cfg:564
msgid ""
"We are free!\n"
"The oppressors must die!"
msgstr ""

#. [scenario]: id=Liberation
#: Flight_Freedom/scenarios/19_Liberation.cfg:621
msgid "This mine is infested with monsters!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:680
msgid "The drakes split into three forces. Malakar led the smallest, a hand-picked team tasked with liberating the former Drakkar Quarry, now known as Bosun's Mine."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/19_Liberation.cfg:691
msgid "Couldn't we have led the scouting? I mean, do you really want us in more caves, Mal? Don't you remember the last ones?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:695
msgid ""
"I do remember them.\n"
"Of all the drakes, we are the most experienced fighting below ground.\n"
"An inexperienced fighter tripping over his own wings in the dark might be enough to destroy us all."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/19_Liberation.cfg:707
msgid "Not to be insensitive, but couldn't we have still used a few of the wing-tripping ones? Come to think of it, it's a pity your dragon friend couldn't fit down here. There's not many of us left, Mal."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/19_Liberation.cfg:713
msgid "Not to be insensitive, but couldn't we have still used a few of the wing-tripping ones? There's not many of us left, Mal."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:719
msgid ""
"Indeed, we have lost a great many.\n"
"So many that we cannot hope to retake this island by ourselves.\n"
"Here, we can liberate others to join our cause."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/19_Liberation.cfg:727
msgid ""
"Dominant, I must again inquire why must we be the drakes to delve into these caves.\n"
"We were fortunate to have avoided the caves of the Isle of Storms."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:732
msgid ""
"We have lost a great many drakes.\n"
"So many that we cannot hope to retake this island by ourselves.\n"
"\n"
"The humans have enslaved drakes of every flight.\n"
"Many forced to toil in mines such as these.\n"
"They but require the direction of a Dominant to rise up against the thinskins and help us drive them away for good!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/19_Liberation.cfg:747
msgid ""
"I am only concerned as your First Intendant that we are needlessly endangering ourselves.\n"
"Especially since Quemar cannot fit down here.\n"
"Should we fall our uprising falls with us."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/19_Liberation.cfg:755
msgid ""
"I am only concerned as your First Intendant that we are needlessly endangering ourselves.\n"
"Should we fall our uprising falls with us."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:762
msgid ""
"Then we cannot afford to fall.\n"
"\n"
"I have decided.\n"
"Drakes, move out!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:772
msgid "NOTE: Your encampment will disappear on turn 2, and your recall list will cease to be available for this scenario."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:817
msgid ""
"The invaders must have dug this tunnel very hastily.\n"
"Tt falls apart already."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:818
msgid "The invaders must have dug this tunnel in a hurry; it's already falling apart."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:821
msgid ""
"It seems that the humans have expanded this mine.\n"
"They even pillage the very foundations of Morogor itself."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:834
msgid "This bridge is shattered."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:845
msgid ""
"There is a gate here.\n"
"Although it may be unwise to open it, I can look through it if I get closer."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:846
msgid "There's a gate here. Although it may be unwise to open it, I can look through it if I get closer."
msgstr ""

#. [then]
#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:863
#: Flight_Freedom/scenarios/19_Liberation.cfg:869
msgid ""
"The thinskins defile even our dead.\n"
"This is no place for bones!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/19_Liberation.cfg:882
msgid "Bones? I thought you guys, you know, went up in smoke."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:886
msgid ""
"Only those who die in battle.\n"
"These drakes have been starved or worked to death.\n"
"As well to spit on our ashes as to keep bones on display."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:899
msgid ""
"These appear to be living quarters for the slaves.\n"
"They must all be at work now."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:900
msgid "These appear to be living quarters for the slaves. They must all be at work now."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:914
msgid "There is a human garrison in the lower tunnels!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:930
msgid "Hello, my brothers."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:934
msgid "Kamalar, is it you?"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/19_Liberation.cfg:944
msgid "Who's this, now?"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:949
msgid ""
"I am the high priest of Dalgar-El, the Murderer.\n"
"I led a small band of warriors into this mine.\n"
"We were outnumbered and forced into this cavern.\n"
"\n"
"We are safe here, beyond the chasm.\n"
"There are sufficient mushrooms here to live on.\n"
"\n"
"But the humans have been repairing the bridge we broke.\n"
"It seems to come closer with each day."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/19_Liberation.cfg:964
msgid "Hail, Kamalar, high-priest of Dalgar-El the Murderer!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:968
msgid ""
"I am heartened to learn that the Kakatars yet live.\n"
"\n"
"I led a small band of warriors into this mine.\n"
"We were outnumbered and forced into this cavern.\n"
"\n"
"We are safe here, beyond the chasm.\n"
"There are sufficient mushrooms here to live on.\n"
"\n"
"But the humans have been repairing the bridge we broke.\n"
"It seems to come closer with each day."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:983
msgid "I request your assistance, brother, in driving the humans from our island."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:987
msgid ""
"Very well.\n"
"We too have borne their yoke.\n"
"Your arrival brings hope.\n"
"\n"
"Malakar, if you can kill my besiegers, the slaves can revolt.\n"
"We would be able to aid them."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1023
msgid "You now control Kamalar's team as well as your own."
msgstr ""

#. [objectives]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1028
#: Flight_Freedom/scenarios/19_Liberation.cfg:1055
msgid "Defeat all human leaders"
msgstr ""

#. [objectives]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1050
#: Flight_Freedom/scenarios/19_Liberation.cfg:1077
msgid "Death of Kamalar"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1141
msgid "This... uh... skeleton had 180 pieces of gold!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1150
msgid ""
"Malakar, you need this gold more than I do.\n"
"You are a Dominant, and I am a priest."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1171
msgid "He was guarding a gate!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1187
msgid "He dropped a book!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1202
msgid "It is a collection of orders and messages. They all appear to have been written by the same hand."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1202
msgid "It's a collection of orders and messages. They look like they've been written by the same person."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1212
msgid "First, gentlemen, I would like to congratulate you on your ingenuity in sparing our citizens. If Prax did not pay for drakes, he no doubt would not have paid what he promised for humans, either. In light of his breach of contract, I am transferring an additional squad of archers to your control. Your orders are to kill Prax and bring back any gold he possesses. Be wary of his magics, but let nothing stop you."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1217
msgid "General Omandro, I received your message that little remained of value in the Baron's estate. We were lucky that the drakes finished him off, but we will be ruined without immediate funds in the royal coffers. Your orders are to find the drakes and see if they took anything of value in their escape. Avoid engaging them unless they cause trouble."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1228
msgid "Your Highness, reports from the field indicate that our dealings with Prax were a dead end. He does not have, and perhaps never had, enough gold to save the kingdom. It pleases me to report that he is now dead and his lands placed under our control. Our only financial hope is our new colony in Morogor. We have our hands on a fortune's worth of their unique stone, yet the first shipments are still months away. We were only able to take Morogor because the natives were divided against each other. We cannot risk Prax's escaped slaves rallying our new Drakish subjects."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1236
msgid "Your Highness, reports from the field indicate that our dealings with Prax were a dead end. He does not have, and perhaps never had, enough gold to save the kingdom. It pleases me to report that he is now dead and his lands placed under our control. Although things look bad, I propose a bold new plan: Grand Marshal Oddryn revealed that it is possible to assault Morogor when the local drakes are taken by surprise. If we claim the island for our own, then we put our hands on a fortune's worth of their unique stone. Wizards and mages from across the land have always paid dearly for even pebbles from Morogor. If we move quickly, the only real obstacle in our way is the danger of Prax's escaped slaves returning home and raising a warning. We could never take Morogor after their defenses have been raised."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1243
msgid "Attention - Omandro and all coastal forces. Your new top priority is to find the escaped Drakish slaves and destroy them. They must not return to Morogor. Pursue over the ocean, if need be. Further instruction will be coming."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/19_Liberation.cfg:1253
msgid "This message is merely an expression of the King's gratitude for your efforts. The kingdom, so long poised on the brink of fiscal collapse, is saved. A few more months' worth of shipments, and we'll not only be financially secure for generations, but we will have the resources to conquer the Northlands and claim the bulk of the continent for ourselves. You have done well, and the King himself thanks you all."
msgstr ""

#. [then]
#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1273
#: Flight_Freedom/scenarios/19_Liberation.cfg:1279
msgid ""
"By Gar-Alagar... this is a torture chamber!\n"
"The humans shall pay tenfold for this!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1292
msgid ""
"An axe... used to dismember drakes.\n"
"How could anyone do this?"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1293
msgid "An axe... used to dismember drakes. How could anyone do this?"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1302
msgid "This is some type of wicked poison, forced down captives' throats."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1311
msgid "Gallows, to kill drakes after their ordeals."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1341
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1021
msgid "Brother!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1345
msgid "I am gone!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1356
msgid ""
"Without him, we will be unable to continue.\n"
"All is lost!"
msgstr ""

#. [message]: speaker=starting_cave_drake
#: Flight_Freedom/scenarios/19_Liberation.cfg:1375
msgid "Your rule ends today, softskin!"
msgstr ""

#. [message]: speaker=starting_cave_drake
#: Flight_Freedom/scenarios/19_Liberation.cfg:1386
msgid ""
"No!\n"
"I shall never see the sun again..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1408
msgid ""
"We have done so.\n"
"Quickly, we must leave for the Temple at once!\n"
"Before the humans learn of their defeat today!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1422
msgid ""
"Do not be so hasty, brother.\n"
"I bring friends."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1427
msgid "Kzzklk, show yourself!"
msgstr ""

#. [unit]: type=Saurian Margrave, id=Kzzklk
#: Flight_Freedom/scenarios/19_Liberation.cfg:1434
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1097
msgid "Kzzklk"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1463
msgid "I am surprised that saurians persist in the depths of a mine."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1467
msgid ""
"I found a small group of them.\n"
"Refugees from the humans, just like us.\n"
"They have allied with me against our enslavers."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1473
msgid ""
"However, once the humans came to Morogor, we had to take refuge here.\n"
"With their help, I was able to avoid their patrols.\n"
"I sustained them with my flame."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1479
msgid ""
"Now, with your arrival, we can emerge from these caverns.\n"
"The saurians can thaw in the open sun.\n"
"Kzzklk, I ask for your assistance once again.\n"
"In the liberation of our capital."
msgstr ""

#. [message]: speaker=Kzzklk
#: Flight_Freedom/scenarios/19_Liberation.cfg:1486
msgid "Yesss! My axxxxe iss reaaaddy!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1490
msgid "Kamalar, tell me, how the saurians may best aid us in our fight."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1494
msgid ""
"The saurians are elusive and deft of foot, but weak at arms.\n"
"I propose that while we attack the humans head-on, the saurians sneak behind the enemy lines and kill their leaders."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1499
msgid ""
"Or I could place the saurians under your command.\n"
"To add to your army."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1504
msgid "I hope that their numbers are sufficient."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1508
msgid "There are around ten, fifteen at most, that remain fit for battle."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1516
msgid ""
"Then there will be a tough fight ahead of us.\n"
"I must decide what I will do with the saurians."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1519
msgid "I shall take command of the saurians."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1524
msgid "Use them well."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1533
msgid "The saurians will try to outflank the humans."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/19_Liberation.cfg:1537
msgid ""
"Very well.\n"
"They will arrive at the third dawn."
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1777
msgid "Slaves! By order of Grand Marshal Yrynyc, you are to be executed for your treason, to the last drake!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/19_Liberation.cfg:1817
msgid "There was a key in this box!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1828
msgid ""
"There is enough wood here to finish the bridge.\n"
"It is awkward to carry but surprisingly light."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1829
msgid "There's enough wood here to finish the bridge. It's awkward to carry, but surprisingly light."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/19_Liberation.cfg:1848
msgid "The bridge is almost finished -- one could almost jump across."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/19_Liberation.cfg:1854
msgid "The bridge is almost finished -- I could almost jump across."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/19_Liberation.cfg:1892
msgid "The bridge is complete!"
msgstr ""

#. [message]: speaker=Cicyn
#: Flight_Freedom/scenarios/19_Liberation.cfg:1952
msgid "Wake up! Wake up, you fools! The slaves have rebelled!"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1976
msgid ""
"There is a large human garrison sleeping here.\n"
"The door is locked from the inside.\n"
"If we could but open it, we could attack the thinskins in their sleep!"
msgstr ""

#. [then]
#: Flight_Freedom/scenarios/19_Liberation.cfg:1978
msgid "There is a large human garrison sleeping here. We could attack them in their sleep, but the door is locked from the inside."
msgstr ""

#. [scenario]: id=Battle_Temple
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:4
msgid "Battle of the Temple"
msgstr ""

#. [side]: type=Lieutenant, id=Rycyn
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:77
msgid "Rycyn"
msgstr ""

#. [side]: type=Lieutenant, id=Rheoran
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:121
msgid "Rheoran"
msgstr ""

#. [side]: type=General, id=Rhyrraent
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:201
msgid "Rhyrraent"
msgstr ""

#. [side]: type=General, id=Lenvan
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:236
msgid "Lenvan"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:390
msgid "Malakar and Kamalar continued moving towards the center of the island, unifying the scattered forces they found and overrunning the human forces they encountered. Within four days they had reached the former High Temple of Gar-Alagar, now the humans' capital fortress of Weswyt. The humans expected no more than scattered resistance, and did not start raising appropriate defenses until the drakish warforce was virtually at the walls."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:406
msgid "Kzzklk's scouts reported that the best approach was from the south, and the drake commanders prepared accordingly."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:418
msgid "Malakar and Kamalar would lead the main force, and the saurian commander, Kzzklk, would lead his force of saurians, in hopes of outflanking the humans."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:489
msgid ""
"This...\n"
"This is raw blasphemy!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:494
msgid ""
"Yes.\n"
"The humans have defiled the High Temple of Gar-Alagar."
msgstr ""

#. [message]: speaker=Kzzklk
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:500
msgid "I will kill meeeeself ssssome humanssss!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:504
msgid ""
"It ends.\n"
"We have been bound, murdered, enslaved, and hounded to the ends of the earth.\n"
"Those of us who live through this day will have seen the fury that only true justice can call!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:510
msgid ""
"Drakes!\n"
"Our vengeance is at hand!\n"
"Commence the assault!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:516
msgid "THE FIGHT FOR FREEDOM BEGINS HERE!!!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:529
msgid ""
"Drakes!\n"
"Gar-Alagar fights with us today as we retake his temple!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:555
msgid "All of the saurian warriors have perished."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:559
msgid ""
"Hear me, drakes!\n"
"Our saurian allies have given their last.\n"
"So that we all may live free again!\n"
"Honor their sacrifice!\n"
"Redouble your efforts!"
msgstr ""

#. [message]: role=whiner
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:591
msgid "Theeere are nooooo mmmore sssssaurians lleft."
msgstr ""

#. [message]: speaker=Kzzklk
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:611
msgid "I dddddie! Fffight ffor meee...avvvennnnge...kkkill huuumansssss..."
msgstr ""

#. [message]: role=pity
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:635
msgid "NOOOOOOOO! Kzzklk! I cannot bear to live!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:672
msgid "An actual dragon! The reports were true!"
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:676
msgid "YES, WRETCHED THINSKIN. I AM VERY REAL. I AM YOUR DEATH."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:680
msgid "Face me, monster. I shall slay you as I have so many drakes before you!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:698
msgid ""
"You...\n"
"You led the humans that took my people captive!\n"
"YOU MURDERED MY DAUGHTER!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:705
msgid "So, you will kill me now?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:709
msgid ""
"A drake marked by the gods.\n"
"Sent to you as my messenger.\n"
"And you slew her like a beast!\n"
"Death is the least you deserve."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:716
msgid "I had my orders. Capture as many drakes as I could, kill any that were in the way. What else could I have done?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:720
msgid "Yet now you give such orders."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:724
msgid "In truth, I began to regret my actions the moment I set sail back to Wesnoth. When I was but a lad, I enlisted in the Royal Army of Wesnoth to bring the King's justice to his enemies at the edge of my sword. When I became a General, then Grand Marshal of the Royal Vanguard, I imagined myself marching at the head of grand conquests in the King's name, not taking slaves like common highwaymen and pirates."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:728
msgid "Though I was born a commoner, my father, a veteran himself, raised me to be a man of honor. He would never have approved of our actions on this island. However, I am but a servant of the King. I could do naught but follow my orders."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:732
msgid ""
"You could have chosen the path of honor.\n"
"Yet though you forced countless drakes into slavery, you gave yourself over to the lowest form of slavery of all.\n"
"Others may call you 'Lord' and 'Grand Marshal'.\n"
"But you are merely a slave.\n"
"A slave to your King."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:740
msgid ""
"But in the end, no matter.\n"
"It was you, you alone, who wielded the blade that struck down my daughter.\n"
"Not some tyrant king across the sea in Wesnoth.\n"
"YOU."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:747
msgid ""
"AND NOW, BY GAR-ALAGAR,\n"
"<b>YOU WILL BURN, IN THIS WORLD AND THE NEXT!!!</b>"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:794
msgid "I give my life... for my King."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:799
msgid "Yarr! A pox on your King, and all the King's men!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:803
msgid "Conqueror of the drakes, yet slain by a filthy pirate."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:809
msgid "Long live Wesnoth! I curse you monsters and pirates to my dying breath!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:819
msgid ""
"You!\n"
"You have no honor at all!\n"
"You have brought so much pain to so many drakes!\n"
"HOW MANY?\n"
"HOW MANY BROKEN FLIGHTS?\n"
"HOW MANY SLAUGHTERED HATCHLINGS?\n"
"HOW MANY SMASHED EGGS?\n"
"HOW MANY DEAD AT YOUR WRETCHED HANDS?"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:836
msgid "You... you were the drake who nearly got away when I first came to this cursed isle! I knew you would be a problem then. I should have had you killed!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:840
msgid ""
"And a coward as well.\n"
"BURN!!!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:847
msgid "Are we truly so different? We captured a pirate ship last month, and I have learned of your betrayal of the pirates. Yet you bleat about 'honor'."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:851
msgid ""
"I care not for softskins.\n"
"Least of all you.\n"
"BURN!!!"
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:883
msgid "HEAR ME, HUMANS. YOUR CHIEF IS DYING. YOU SHALL TASTE DEATH THIS DAY AS WELL."
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:890
msgid "You... you were the chief of the swamp tribe! Curses, I knew we should have brought an additional cavalry division!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:895
msgid ""
"Yet you failed to stop us.\n"
"Our spirit, and the spirit of every drake on this island, remains strong!\n"
"You could only hope to fail.\n"
"And now you will die!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:905
msgid "You will burn in the pits of eternity!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:919
msgid "GUARDS!!! Slay them all!"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:946
msgid "Long live Wesnoth! I curse you monsters to my dying breath!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:960
msgid "MOROGOR IS OURS!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:973
msgid ""
"But this is bittersweet.\n"
"My brother is dead...\n"
"Just like Necolag, my daughter."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:985
msgid "He died fighting for you. Like any of your other soldiers would."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:989
msgid "He was a true warrior."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:995
msgid "He may have lived as a priest but he died as a warrior."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:999
msgid "He shall be forever remembered."
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1025
msgid ""
"I am gone!\n"
"Fight on against the humans without me!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1041
msgid ""
"The humans' audacity knows no bounds.\n"
"Their squatters have defiled the Temple!"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1057
msgid "Pirate! You're a traitor to your own race!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1061
msgid "I have plied the seas for years, and indeed I have plundered many a navy ship. Yet you pillage an entire island, and call me a pirate. Who among us are the greatest criminals?"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1078
msgid "Malakar, the so-called 'dominant'. I shall hoist your skull above the ramparts of Weldyn, as an example to all who dare oppose the might of Wesnoth!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1082
msgid "And your flayed corpse shall burn in Mount Morogor."
msgstr ""

#. [message]: speaker=Kzzklk
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1165
msgid "At yooourrr ccccommaaaand!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1181
msgid "They have fortified the entrance!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1185
msgid ""
"The tower has fallen into disrepair.\n"
"Onward!"
msgstr ""

#. [unit]: id=C'onolar, type=Drake Thrasher
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1221
msgid "C'onolar"
msgstr ""

#. [message]: speaker=C'onolar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1284
msgid ""
"Malakar of the Kakatars!\n"
"Fighting has broken out in huge battles across the island!\n"
"Every able-bodied drake remaining has pledged their lives.\n"
"To prevent the human reinforcements from reaching the Temple.\n"
"They can buy you no more than a few days.\n"
"Make the most of this time!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1293
msgid "Look sharp! You've been followed!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1297
msgid ""
"On guard!\n"
"You have pursuers!"
msgstr ""

#. [event]: id=Garranath
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1307
msgid "Garranath"
msgstr ""

#. [message]: speaker=Garranath
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1312
msgid ""
"We are some of the last survivors of the Obsidian Citadel.\n"
"Our fireballs are at your command!"
msgstr ""

#. [message]: speaker=squad2_leader
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1395
msgid "All right men, let's kill some lizards!"
msgstr ""

#. [message]: speaker=Kamalar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1403
msgid ""
"Our forces cannot press this attack much longer!\n"
"Hurry!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/20_Battle_of_the_Temple.cfg:1412
msgid ""
"We cannot fight any longer!\n"
"We have failed!"
msgstr ""

