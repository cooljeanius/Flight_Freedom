#: Flight_Freedom/scenarios/08a_Landfall.cfg:332
msgid "Ieeeeee!"
msgstr ""

#. [message]: speaker=Malakar
#. [message]
#: Flight_Freedom/scenarios/08a_Landfall.cfg:381
#: Flight_Freedom/scenarios/08a_Landfall.cfg:387
msgid "The bridge collapsed!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:406
msgid "Phew, good thing I wasn't standing on that rickety thing!"
msgstr ""

#. [wml_message]
#. debug message; ok to skip translating:
#: Flight_Freedom/scenarios/08a_Landfall.cfg:427
msgid "The Unforgiver survived the bridge collapse!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:435
msgid "Oh no, my ship!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/08a_Landfall.cfg:467
msgid "I do not trust this bridge."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/08a_Landfall.cfg:479
msgid "This bridge be rickety!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/08a_Landfall.cfg:485
msgid "I don't trust this bridge!"
msgstr ""

#. [unit]: id=Passing Wind, type=Dreadnought
#. This name is a pun:
#: Flight_Freedom/scenarios/08a_Landfall.cfg:516
msgid "Passing Wind"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:574
msgid ""
"(Malakar) Fie!\n"
"The humans pursue us!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:580
msgid "(Kogw) Blast! There's low wind and we're in the island's tide. Our best bet is to land and hope they hesitate long enough for us to ready our defense."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:585
msgid ""
"(Malakar) There is an old fortress on the eastern horizon.\n"
"We can make our stand there."
msgstr ""

#. [unit]: id=Jako, type=General
#: Flight_Freedom/scenarios/08a_Landfall.cfg:617
msgid "Jako"
msgstr ""

#. [message]: speaker=Skula-Teroa
#: Flight_Freedom/scenarios/08a_Landfall.cfg:681
msgid "Intruders! Die!"
msgstr ""

#. [message]: speaker=Jako
#: Flight_Freedom/scenarios/08a_Landfall.cfg:707
msgid "Men, be prepared for attacks from the South, but the Drakes remain our primary objective. Move out!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:811
msgid "They broke through our blockade!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:818
msgid "(Kogw) They broke through our blockade!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:922
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:777
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:897
msgid "A spirit has attacked!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:929
msgid "(Kogw) A spirit has attacked!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:946
msgid "By the smoke of Gar-Alagar... a spirit!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:958
msgid ""
"It... it did not attack.\n"
"It just appeared."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:971
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:812
msgid "I only hope that you will not say that EVERY time."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:990
msgid "(Malakar) By the smoke of Gar-Alagar... a spirit!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1003
msgid ""
"(Malakar) It... it did not attack.\n"
"It just appeared."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1011
msgid "(Malakar) I only hope that you will not say that EVERY time."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1131
msgid ""
"We have landed in the heart of the human camp.\n"
"You will speak to me as to why."
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1137
msgid "(Kogw) I'm truly sorry, Mal, but I can't keep doing this. The drake is all yours, boyos."
msgstr ""

#. [message]: speaker=slayer
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1166
msgid "RUARRAGH!"
msgstr ""

#. [message]: speaker=Unforgiver
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1171
msgid "(Kogw) Back on the boat!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1202
msgid ""
"They have summoned reinforcements!\n"
"Burn down their ships!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1207
msgid "By the Eyes... it's hopeless, Malakar! That's a whole fleet of their finest. We must retreat!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1217
msgid ""
"Cowardly thinskin.\n"
"\n"
"We are drakes!\n"
"We shall take to the skies at once and make pyres of their worthless boats!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1224
msgid ""
"No, Theracar.\n"
"I fear the pirate has the way of it.\n"
"\n"
"Our flight has spent much of our strength on our journey.\n"
"We would not survive a mad charge into their arrows and ballista bolts.\n"
"We must regroup farther inland."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1235
msgid ""
"Hmm... so be it.\n"
"Regroup farther inland!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1242
msgid "Forgive me, darling. I've never had the honor of captaining a finer ship."
msgstr ""

#. [message]: speaker=Unforgiver
#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1247
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1256
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:875
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:607
#: Flight_Freedom/scenarios/15_Gate_of_Storms.cfg:370
#: Flight_Freedom/scenarios/17b_Parched_Sands.cfg:679
msgid "..."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1251
msgid "Haaarh. You must see, I have no choice. My hands are tied."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1260
msgid "Let us go!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1358
msgid "They have summoned reinforcements!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/08a_Landfall.cfg:1362
msgid "It's hopeless, Malakar. That's a whole fleet of their finest, and we can't escape!"
msgstr ""

#. [scenario]: id=Apocalypse
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:4
msgid "Apocalypse"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:180
msgid "<b>EPILEPSY WARNING</b>: this scenario contains flashing lights which may potentially trigger seizures for people with photosensitive epilepsy."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:182
#: Flight_Freedom/scenarios/11b_Solkans_Lair.cfg:499
msgid "Continue normally"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:188
msgid "Continue without flashing lights"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:196
msgid ""
"Mount Morogor...\n"
"As majestic as the day of my ascension to Dominant of my flight..."
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:201
msgid ""
"I recall my ascension as well.\n"
"It is a true shame that war beckons at this most sacred place."
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:211
msgid ""
"Blasphemy!\n"
"Blasphemy!\n"
"\n"
"You seek to claim the mantle of Gar-Alagar himself!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:218
msgid ""
"Silence!\n"
"The future of our entire race rests on our shoulders!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:225
msgid "Quemar, I trust that you have finished your preparations."
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:229
msgid ""
"I shall fulfill my duty.\n"
"Until my end and beyond."
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:234
msgid ""
"Very well.\n"
"\n"
"Quemar, I shall accompany you to the mouth of the volcano.\n"
"Apprentices, set forth to take your places."
msgstr ""

#. [event]: id=apprentice_1, id=apprentice_2, id=apprentice_3, id=apprentice_4
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:288
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:307
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:326
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:345
msgid "Apprentice"
msgstr ""

#. [event]: id=apprentice_1, id=apprentice_2, id=apprentice_3, id=apprentice_4
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:360
msgid "Move all four apprentices to the platforms"
msgstr ""

#. [event]: id=apprentice_1, id=apprentice_2, id=apprentice_3, id=apprentice_4
#. [objectives]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:362
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:755
msgid "Death of an apprentice"
msgstr ""

#. [event]: id=apprentice_1, id=apprentice_2, id=apprentice_3, id=apprentice_4
#. [objectives]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:365
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:758
msgid "Death of Quahgakar"
msgstr ""

#. [message]: speaker=messenger_08b
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:396
msgid ""
"The humans are closing in on Mount Morogor!\n"
"Doubtless they know that to conquer its slopes would break the spirit of every drake on the island."
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:401
msgid "Then we must make haste!"
msgstr ""

#. [unit]: id=NW_leader, type=$enemy_leader_type
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:528
msgid "Urien"
msgstr ""

#. [message]: speaker=NW_leader
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:536
msgid "In the name of the King, Morogor shall be ours! Long live Wesnoth!"
msgstr ""

#. [unit]: id=NE_leader, type=$enemy_leader_type
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:555
msgid "Galeran"
msgstr ""

#. [message]: speaker=NE_leader
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:563
msgid "Soldiers of Wesnoth! Our conquest of this island is nearly complete. Soon its riches shall be ours for the taking!"
msgstr ""

#. [unit]: id=SW_leader, type=$enemy_leader_type
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:582
msgid "Rolland"
msgstr ""

#. [message]: speaker=SW_leader
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:590
msgid "Sound the charge! For Wesnoth!"
msgstr ""

#. [unit]: id=SE_leader, type=$enemy_leader_type
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:609
msgid "Emeric"
msgstr ""

#. [message]: speaker=SE_leader
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:617
msgid "We have them surrounded! Onward!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:733
msgid ""
"We are all in place!\n"
"Let us begin the convocation at once!"
msgstr ""

#. [objectives]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:753
msgid "Survive for $num_turns_to_survive turns ($($turn_number - $survival_start_turn) / $num_turns_to_survive)"
msgstr ""

#. [message]: role=concerned_human
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:797
msgid "The lizards are conducting some strange ritual! We must stop them immediately!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:848
msgid ""
"The humans are redoubling their efforts!\n"
"Quahgakar, it must be possible for you to finish this ritual faster."
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:853
msgid ""
"The ritual cannot be rushed unless you wish to condemn all of us to a fate worse than death.\n"
"But there may be an alternative..."
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:858
msgid "No... not that... please..."
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:862
msgid ""
"It would involve the darkest of magicks.\n"
"But we can force Mount Morogor to erupt.\n"
"\n"
"The lava flows would sweep the thinskins from our lands!\n"
"And it could be done at a moment's notice."
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:870
msgid ""
"Malakar, if we do this, Morogor will never be the same.\n"
"I implore you to think carefully!"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:877
msgid "We continue with our original plan to awaken Quemar as a dragon!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:882
msgid ""
"Drakes!\n"
"Hold the line while the magi finish their work!"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:888
msgid "There is no time! We must purge the humans before they slaughter us all!"
msgstr ""

#. [message]: speaker=Morlin Ka
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:897
msgid ""
"Turn back at once!\n"
"Gar-Alagar will never forgive this!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:902
msgid ""
"My will is set.\n"
"The thinskins are closing in.\n"
"Either Mount Morogor erupts or we all die!"
msgstr ""

#. [message]: speaker=Hartholar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:910
msgid ""
"Very well, Malakar.\n"
"Drakes! Take flight at once!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:929
msgid ""
"The hour grows near!\n"
"We must stand firm just a while longer!"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1061
msgid "Powers below, hear me! Powers above, fear me!"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1072
msgid "I call upon your wrath! Accept our life force, so that your fires may be quickened!"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1151
msgid "Accept my sacrifice of blood, so that your hatred may surge forth!"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1173
msgid "And now I offer myself to the flames."
msgstr ""

#. [fading_message]: id=Malakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1242
msgid "What... what have we done..."
msgstr ""

#. [message]: speaker=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1395
msgid "Quahgakar, let us begin."
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1407
msgid "Breath of Gar-Alagar! Spirit of Morogor! Hear my voice."
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1418
msgid "Accept your servant and infuse him with your might!"
msgstr ""

#. [fading_message]: id=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1430
msgid "Hear me, a humble servant."
msgstr ""

#. [fading_message]: id=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1451
msgid "I walk the path of my ancestors."
msgstr ""

#. [fading_message]: id=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1463
msgid "I walk to the edge of death."
msgstr ""

#. [fading_message]: id=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1475
msgid "And return with new life."
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1488
msgid "Open the way to the heart of the fire!"
msgstr ""

#. [fading_message]: id=Quemar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1595
msgid "I surrender, to be reborn in flame."
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1641
msgid "Malakar, it is done."
msgstr ""

#. [fading_message]: id=Hartholar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1661
msgid "Quahgakar, what's happening?"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1683
msgid "The ritual, it's going out of control!"
msgstr ""

#. [fading_message]: id=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1741
msgid "The life force needed was much greater than I had imagined... the spell stole what it sought from us!"
msgstr ""

#. [message]: speaker=capturer_1
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1851
msgid "We have found the last of the rebels! Shall we kill them?"
msgstr ""

#. [message]: speaker=Yrynyc
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:1855
msgid "No. Bind them in iron fetters and muzzle their snouts. I intend to make an example out of them, so all drakes may fear the name of our King!"
msgstr ""

#. [message]: speaker=messenger_08b
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2119
msgid ""
"Mount Morogor...\n"
"It calls me..."
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2131
msgid ""
"No!\n"
"We cannot complete the ritual!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2153
msgid ""
"We must protect the apprentices at all cost!\n"
"Only with their combined will can we contain the energies we hope to let forth!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2172
msgid ""
"No!\n"
"Without our apprentices we cannot complete the ritual!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2195
msgid ""
"The spirits are growing restless!\n"
"We must begin the ritual swiftly!"
msgstr ""

#. [message]: speaker=Quahgakar
#: Flight_Freedom/scenarios/08b_Apocalypse.cfg:2205
msgid ""
"No!\n"
"The magic in the air is fading.\n"
"We cannot complete the ritual!"
msgstr ""

#. [scenario]: id=Drake_Escape
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:4
msgid "The Drake Escape"
msgstr ""

#. [side]: type=General, id=Hago
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:43
msgid "Hago"
msgstr ""

#. [side]: type=Orcish Warlord, id=Dredgno
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:58
msgid "Dredgno"
msgstr ""

#. [side]: type=Elvish Captain, id=Einelen
#. [then]: type=Elvish Captain, id=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:106
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:480
msgid "Einelen"
msgstr ""

#. [scenario]: id=Drake_Escape
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:159
msgid "Move Malakar and Kogw to the cave"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:213
msgid "We're completely outmanned! When we get to these caves we've got to vanish; we must escape through the bowels of the earth!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:217
msgid ""
"No, Kogw.\n"
"We must regroup and begin a counterattack.\n"
"\n"
"We are not bats!\n"
"Wings do not work very well underground.\n"
"Neither do cold blooded Drakes!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:226
msgid "Our enemies are at are our very backs! We must flee!"
msgstr ""

#. [message]: speaker=Einelen
#. Meneldur is from Saving Elensefar:
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:231
msgid "Kogw, your time has come! I, Einelen, son of Meneldur, shall make you pay for every Wose that you have murdered!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:235
msgid "Kogw, I demand to know what he speaks of."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:239
msgid "Arr, the Unforgiver. She's made of Wose wood. Bloody strong stuff, but the Elves seem to worship those walking trees."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:275
msgid ""
"This can hardly be what all this is about, softskin.\n"
"Malakar, I demand to speak with you alone!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:280
msgid ""
"There is no time, Theracar!\n"
"\n"
"I need you to scout out the cave immediately.\n"
"Decide if it will be safe for us there."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:298
msgid "This is not over, human."
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:321
msgid "We have found the foul one and his escorts. Remember! Parley with him not, and beware his silver tongue. We have traveled far, but shall not rest until our arrows pin him to the very earth his touch corrupts."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:325
msgid "Wow. Now that's a firm order. If there's any way to get to the cave without going through those forests, I'd really appreciate it, Malakar."
msgstr ""

#. [message]: speaker=Hago
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:333
msgid "Hail, Orcish... um... King! You see our forces and must know that we have the ability to crush you. I propose an alternate plan. You will bring us the head of the drake leader, and we will leave your land. Additionally, we will leave behind every weapon we carry with us. You could become the most powerful leader on this island!"
msgstr ""

#. [message]: speaker=Dredgno
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:337
msgid "Heuh! Now that is treating a warrior with respect! So be it!"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:342
msgid "Even with your combined forces, we can hold you off at the borders of the forests indefinitely. However, we will not hinder your passage into the forest on two conditions: first, you leave when your work is done. Second, you slay the human who travels with the drakes."
msgstr ""

#. [message]: speaker=Hago
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:346
msgid "On behalf of both our peoples, let it be so."
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:350
msgid "Let it be so."
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:386
msgid "I have traveled too far to fall today!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:424
msgid "Einelen vanishes with a magical word!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:457
msgid "Underground!"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:487
msgid "The caves... Drake leader! Halt!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:497
msgid ""
"There has been too much death here today.\n"
"We must leave."
msgstr ""

#. [message]: speaker=Dredgno
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:504
msgid "Heungah! You cannot run from our forces!"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:508
msgid "Halt! Please!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:512
msgid "We have no reason to speak with you."
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:516
msgid "We do not need to be your enemies. I propose a peace offering."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:571
msgid "I see. You have my complete attention, elf."
msgstr ""

#. [message]: role=wimporc
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:585
msgid "Dredgno? Boss?"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:591
msgid "Our quarrel is not with you. Give us Kogw, and we will leave you be."
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:609
msgid "Kogw has fought by our side even against other thinskins. Honor demands that I stand with him now!"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:614
msgid "Our lives are long but our memories are longer! The forests shall forevermore be your foe!"
msgstr ""

#. [option]
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:625
msgid "My first duty must be to my fellow drakes. We cannot afford more enemies. If this means that Kogw must die then so be it."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:645
msgid "I understand. Farewell, Malakar. Time for me to dance the hempen jig..."
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:653
msgid "Hear, hear! For his crimes against the Woses and my people, I hereby condemn the pirate to death. He is to be bound in living fetters of vine over a sapling, which shall slowly impale him as it grows while the faerie magic of the forest sustains his loathsome existence until a branch pierces his black heart!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:657
msgid "No! Mercy, I beg of you! NO!!!"
msgstr ""

#. [message]: speaker=Einelen
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:685
msgid "All interlopers must leave the forest at once! Drakes, for your cooperation you may cross through the forest just this once to the southern edge while your pursuers must travel along the coast; do not tarry or you shall join the pirate in death."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:787
msgid "Do these spirits pursue us, too?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:799
msgid ""
"It did not attack!\n"
"It just appeared!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:842
msgid ""
"They pursue us!\n"
"We must hurry!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:856
msgid "They murdered those people in cold blood! Those bloodthirsty monsters..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:860
msgid ""
"You are shocked only because the orcs are disorganized.\n"
"The thinskins plan their killings.\n"
"They are the ones that we must be wary of."
msgstr ""

#. [message]: speaker=wolf_squad_leader
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:927
msgid "Hup hup! At them!!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:931
msgid "To the caves! Quickly!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:957
msgid "Wose-slayer! The spirits of the forest thirst for vengeance!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:961
msgid "Oh, shut up, forest rat."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:973
msgid ""
"Forgive me, Malakar.\n"
"But there is no time.\n"
"\n"
"Drakes!\n"
"Seal the cave before the human reinforcements arrive!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:981
msgid ""
"No!\n"
"I beg you!\n"
"I can make it!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/09_The_Drake_Escape.cfg:1001
msgid "Theracar!"
msgstr ""

#. [side]: type=Dwarvish Lord, id=Gomdrathsil
#: Flight_Freedom/scenarios/10a_Underground.cfg:38
msgid "Gomdrathsil"
msgstr ""

#. [side]: type=Dwarvish Lord, id=Gomdrathsil
#. [side]: type=Dwarvish Lord, id=Palmathio
#. [side]: type=Dwarvish Steelclad, id=Trithdurus
#. [side]: type=Dwarvish Lord, id=Dulating
#. [side]: type=Dwarvish Steelclad, id=Augcatsil
