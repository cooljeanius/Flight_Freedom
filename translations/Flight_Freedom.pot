#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:4
msgid "Swamps of the Jamolar"
msgstr ""

#. [scenario]: id=Swamps_Jamolar
#: Flight_Freedom/scenarios/02b_Swamps_of_the_Jamolar.cfg:17
msgid "Survive for 20 turns"
msgstr ""

