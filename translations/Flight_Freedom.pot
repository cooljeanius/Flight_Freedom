msgstr ""

#. [unit_type]: id=Dreadnought, race=ship
#: Flight_Freedom/units/boats/Dreadnought.cfg:5
msgid "Dreadnought"
msgstr ""

#. [unit_type]: id=Dreadnought, race=ship
#: Flight_Freedom/units/boats/Dreadnought.cfg:24
msgid "Dreadnoughts are the pride of the humans' navy. With 3 ballistas and a catapult, they can sink or kill almost anything unlucky enough to be in their way."
msgstr ""

#. [unit_type]: id=Frigate, race=ship
#: Flight_Freedom/units/boats/Frigate.cfg:5
msgid "Frigate"
msgstr ""

#. [unit_type]: id=Frigate, race=ship
#: Flight_Freedom/units/boats/Frigate.cfg:23
msgid "The Frigate is rather slow, but it is powerful and well-protected."
msgstr ""

#. [unit_type]: id=Galleon2, race=ship
#: Flight_Freedom/units/boats/Galleon.cfg:5
msgid "Galleon"
msgstr ""

#. [unit_type]: id=Galleon2, race=ship
#: Flight_Freedom/units/boats/Galleon.cfg:23
msgid "Galleons are human sailing warships, used for exploration and combat. Though they are large and expensive, they are very strong. Armed with three ballistas, they mete out justice with deadly efficiency."
msgstr ""

#. [unit_type]: id=Pirate Cruiser, race=ship
#: Flight_Freedom/units/boats/Pirate_Cruiser.cfg:5
msgid "Pirate Cruiser"
msgstr ""

#. [unit_type]: id=Pirate Cruiser, race=ship
#: Flight_Freedom/units/boats/Pirate_Cruiser.cfg:24
msgid "The Pirate Cruiser is a larger pirate ship, either taken as plunder or built in a clandestine shipyard. It has 3 ballistas."
msgstr ""

#. [unit_type]: id=Pirate Galleon2, race=ship
#: Flight_Freedom/units/boats/Pirate_Galleon.cfg:5
msgid "Pirate Galleon"
msgstr ""

#. [unit_type]: id=Pirate Galleon2, race=ship
#: Flight_Freedom/units/boats/Pirate_Galleon.cfg:25
msgid "The Pirate Galleon is a former battleship of the Wesnothian navy, captured by renegades and pressed into service. It has 5 ballistas."
msgstr ""

#. [unit_type]: id=Pirate Sloop, race=ship
#: Flight_Freedom/units/boats/Pirate_Sloop.cfg:5
msgid "Pirate Sloop"
msgstr ""

#. [unit_type]: id=Pirate Sloop, race=ship
#: Flight_Freedom/units/boats/Pirate_Sloop.cfg:25
msgid "Pirates are the aquatic vector of Thieves. Manned by human renegades, these widely feared ships ply the seaways in search of plunder."
msgstr ""

#. [unit_type]: id=Pirate War Galley, race=ship
#: Flight_Freedom/units/boats/Pirate_War_Galley.cfg:5
msgid "Pirate War Galley"
msgstr ""

#. [unit_type]: id=Pirate War Galley, race=ship
#: Flight_Freedom/units/boats/Pirate_War_Galley.cfg:24
msgid "Some pirates are not content to sink their prey from afar. Their captains trade larger sails for banks of oars, delighting in reckless charges against their hapless victims. Although their broadsides are less powerful than other ships of similar tonnage, their cast iron rams are capable of breaking smaller ships in two and severely damaging larger ships."
msgstr ""

#. [attack]: type=impact
#: Flight_Freedom/units/boats/Pirate_War_Galley.cfg:29
msgid "ram"
msgstr ""

#. [unit_type]: id=Cave Drake, race=drake
#: Flight_Freedom/units/drakes/Cave.cfg:5
msgid "Cave Drake"
msgstr ""

#. [unit_type]: id=Cave Drake, race=drake
#: Flight_Freedom/units/drakes/Cave.cfg:21
msgid "Those drakes that are born and raised in caves often suffer from stunted growth and other deformities, as their internal fire never burns quite as intensely as the fires of surface-dwellers. Although these drakes are frail and weak aboveground (by drake standards), their small size makes them perfectly suited for scouting caves ahead of the warriors of a flight."
msgstr ""

#. [attack]: type=blade #impact
#: Flight_Freedom/units/drakes/Cave.cfg:30
msgid "bite"
msgstr ""

#. [unit_type]: id=Drake Chieftain, race=drake
#. [unit_type]: id=Drake Chieftain Silhouette, race=monster
