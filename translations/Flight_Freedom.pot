#. [objectives]
#. [scenario]: id=Rebellion
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:912
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1009
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:127
msgid "Kill the overseer"
msgstr ""

#. [objectives]
#. [scenario]: id=Rebellion
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1137
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:128
msgid "Rescue the Hatchlings"
msgstr ""

#. [fading_message]
#. [unit_type]: id=Slave Driver, race=human
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:641
#: Flight_Freedom/units/humans/Loyalist_Slave_Driver.cfg:5
msgid "Slave Driver"
msgstr ""

#. [fading_message]
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:642
msgid "WORK!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:684
msgid "ARRGH!"
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:688
msgid ""
"Malakar, the guards' fresh replacements are late.\n"
"Is this our time to strike?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:694
msgid ""
"Our rebellion has not yet been fully planned out.\n"
"But if we wait any longer we will have no strength left at all."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:700
msgid ""
"Kin!\n"
"Rally to me!\n"
"Gather what strength you have!\n"
"Our hour is come!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:715
msgid "This, human, is for my daughter!"
msgstr ""

#. [message]: speaker=Overseer
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:726
msgid "Men! Round up the slaves, and make them suffer for their disobedience!"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:737
msgid "Die the death you meant for us!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:825
msgid "The hatchlings are free!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:832
msgid "The hatchlings are free! We must kill the taskmaster!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:838
msgid ""
"Malakar... our hatchlings... they've been tortured and wounded.\n"
"Why... why would they do this?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:844
msgid ""
"Listen to me!\n"
"If any of you have any sense of justice, find a thinskin and cleanse this world of a little of their evil!"
msgstr ""

#. [unit]: id=Guard1, type=Spearman
#. [unit]: id=Guard2, type=Spearman
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:865
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:874
msgid "Guard"
msgstr ""

#. [message]: speaker=Overseer
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:885
msgid "Kill the hatchlings! Kill them all!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:890
msgid ""
"The guards have arrived!\n"
"Protect the hatchlings!"
msgstr ""

#. [objectives]
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:902
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:913
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1127
msgid "Kill both guards"
msgstr ""

#. [objectives]
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:903
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:914
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1010
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1128
msgid "At least four hatchlings must survive ($hatchling_count / 4)"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:953
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1099
msgid ""
"The manor house lies ahead!\n"
"Tear out its black heart!\n"
"Leave its shell for the vultures!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:976
msgid ""
"The overseer shall pay for the sufferings of our hatchlings!\n"
"The debt must be paid in blood!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:990
msgid ""
"Let us make the overseer pay for that hatchling!\n"
"A life for a life!!"
msgstr ""

#. [message]: speaker=Malakar
#. if this would not work in the target language, feel free to remove the number of hatchlings:
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:999
msgid ""
"$hatchlings_killed hatchlings gone!\n"
"Overseer, your time has come!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1028
msgid ""
"Our hatchlings are under attack!\n"
"Hurry!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1051
msgid ""
"NO!!\n"
"\n"
"Our hatchlings... even if we win this battle, the heart of our flight is lost.\n"
"Oh, Necolag, I am sorry..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1070
msgid ""
"The thinskins are slaughtering our hatchlings!\n"
"Our flight is nearly broken!"
msgstr ""

#. [message]: speaker=second_unit
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1115
msgid ""
"The taskmaster - that monster - is dead!\n"
"We must free the hatchlings!"
msgstr ""

#. [message]: speaker=Halberdier
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1208
msgid "Slaves! Surrender or die!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1213
msgid ""
"The Baron's army has arrived!\n"
"We are defeated... for now."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/02a_Rebellion.cfg:1236
msgid ""
"We may have lost some of our hatchlings today.\n"
"But we shall avenge our fallen!\n"
"Onwards!"
msgstr ""

