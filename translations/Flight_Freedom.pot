#: Flight_Freedom/scenarios/10a_Underground.cfg:46
#: Flight_Freedom/scenarios/10a_Underground.cfg:67
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:83
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:98
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:113
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:128
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:143
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:158
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:63
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:83
msgid "Dwarves"
msgstr ""

#. [side]: type=Dwarvish Lord, id=Palmathio
#: Flight_Freedom/scenarios/10a_Underground.cfg:59
msgid "Palmathio"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:203
msgid ""
"I need everyone to stay calm.\n"
"We must move deeper into the cave.\n"
"There is no way of knowing how long the boulder will hold off the elves."
msgstr ""

#. [message]: speaker=Theracar
#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/10a_Underground.cfg:215
#: Flight_Freedom/scenarios/10a_Underground.cfg:223
msgid "We should regroup and prepare to attack them as they enter one-at-a-time!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:229
msgid ""
"No.\n"
"They will not enter after the first ambush.\n"
"Instead they will starve us out.\n"
"We need an alternate exit."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:246
msgid "Hm, let me see if I can use the flames of my sword to brighten up the area around me..."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:328
msgid "$chest1_gold pieces of gold were in this chest!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:335
msgid "Well, well, well. $chest1_gold pieces of gold were in this chest!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:372
msgid ""
"Hey!\n"
"$chest2_gold pieces of gold!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:380
msgid "Hey! $chest2_gold pieces of gold!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:411
msgid "Hmmm... $chest3_gold pieces of gold were in this chest!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:446
msgid ""
"Look here.\n"
"$chest4_gold pieces of gold!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:460
msgid "Booty! $chest4_gold pieces of gold!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:467
msgid "Look here. $chest4_gold pieces of gold!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/10a_Underground.cfg:498
msgid "I'll wager there's a hidden door around here -- I can feel it!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:530
msgid ""
"Half-men.\n"
"I require direction.\n"
"Tell me where these caves reach the surface."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:536
msgid "Half...? Are you the blikkers who just smashed up the doorway?"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:540
msgid ""
"Many elves were in pursuit.\n"
"We had no other choice."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:545
msgid "And you've brought elves in here with you? Gol, by the Beard. This is nothing less than an invasion! Mobilize! Dwarven units, mobilize!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:560
msgid "There must have been a great battle here..."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:574
msgid "Hmmm... the bones of a dragon."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/10a_Underground.cfg:587
msgid "I feel my internal fire flickering as I approach the sinister-looking statue I can see ahead..."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/10a_Underground.cfg:587
msgid "I'm getting a funny feeling as I approach the sinister-looking statue I can see ahead..."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:617
msgid "Maybe we should have someone who is a bit more... expendable... investigate it instead..."
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10a_Underground.cfg:633
msgid "Hmmm... a statue of a dragon."
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/10a_Underground.cfg:637
msgid ""
"I feel strangely tired.\n"
"Something is...\n"
"\n"
"Help me!\n"
"Help me!"
msgstr ""

#. [event]
#: Flight_Freedom/scenarios/10a_Underground.cfg:641
msgid "I feel strangely tired. Something is... help me! Help me!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:684
msgid "Oh no!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/10a_Underground.cfg:701
msgid "Uh..."
msgstr ""

#. [unit]: type=Skeletal Dragon, id=deaddragon
#: Flight_Freedom/scenarios/10a_Underground.cfg:715
msgid "Krent"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:730
msgid "$victim_name|!"
msgstr ""

#. [message]: speaker=deaddragon
#: Flight_Freedom/scenarios/10a_Underground.cfg:734
msgid "RUARRRRR!!! New life flows through me!!!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10a_Underground.cfg:738
msgid "By the flame!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:742
msgid ""
"Old one!\n"
"We are the children of your race, the drakes, children of dragons.\n"
"We need your help.\n"
"Come to the aid of your kin!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/10a_Underground.cfg:749
msgid "But Malakar, look at that thing! It is a dark abomination! We can't ally with such evil!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10a_Underground.cfg:753
msgid "*snarl*"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10a_Underground.cfg:758
msgid ""
"If he is undead, it is not by his own choosing.\n"
"We drakes may be only shadows of his might.\n"
"Yet the same fire that once flowed through his veins flows through ours.\n"
"\n"
"He is drakekin.\n"
"I shall ask for his aid."
msgstr ""

#. [message]: speaker=deaddragon
#: Flight_Freedom/scenarios/10a_Underground.cfg:768
msgid "Yes. Even though I am bound in this foul unlife, I recognize our consanguinity. The summoner I once fell to is now long dead, and my will is now free."
msgstr ""

#. [unit]: type=General, id=Grilcyn
#. [side]: type=General, id=Grilcyn
#: Flight_Freedom/scenarios/10a_Underground.cfg:795
#: Flight_Freedom/scenarios/11a_River_of_Skulls.cfg:54
msgid "Grilcyn"
msgstr ""

#. [message]: speaker=Grilcyn
#: Flight_Freedom/scenarios/10a_Underground.cfg:822
msgid "Break out your torches, men, the drakes must be just ahead."
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/scenarios/10a_Underground.cfg:826
msgid "The humans follow us! We must continue!"
msgstr ""

#. [message]: speaker=Grilcyn
#: Flight_Freedom/scenarios/10a_Underground.cfg:847
msgid "The drakes cannot escape now! Quickly men, kill them!"
msgstr ""

#. [message]: speaker=Grilcyn
#: Flight_Freedom/scenarios/10a_Underground.cfg:851
msgid "Oh, and bring me the head of the pirate."
msgstr ""

#. [scenario]: id=Freezing_Foothills
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:4
msgid "Freezing Foothills"
msgstr ""

#. [side]: type=Troll Hero, id=Buk Shuurb
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:44
msgid "Bük Shuurb"
msgstr ""

#. [side]: type=Troll Hero, id=Buk Shuurb
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:52
msgid "Local Trolls"
msgstr ""

#. [side]: type=Orcish Warlord, id=Prurbo
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:63
msgid "Prurbo"
msgstr ""

#. [side]: type=Orcish Sovereign, id=Ugho
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:82
msgid "Ugho"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:218
msgid "True to their word, the elves did not attack the drakes. Nonetheless, their warriors relentlessly drove the drakes onward. Meanwhile the forest itself seemed to hinder the drakes; vines would seemingly grow from nowhere to ensnare those who took flight, drakes would frequently find themselves stumbling into dead ends, and every drake in the flight felt they were being watched by the wind and the trees."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:225
msgid "Disorganized and tired, the drakes finally began to emerge from the forest after several days of hard travel."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:231
msgid ""
"Finally, we have reached the edge of the forest!\n"
"We will make camp and regroup as a flight."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:242
#: Flight_Freedom/scenarios/12a_Rockfall.cfg:206
msgid "I feel well enough to fight again, Malakar."
msgstr ""

#. [message]: speaker=Ugho
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:252
msgid "These are our lands, lizards. For your trespass you shall die!"
msgstr ""

#. [message]: speaker=Buk Shuurb
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:256
msgid "NEW FLAVORS FOR THE COOK-POT! WE FEAST TONIGHT!!!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:260
msgid ""
"We cannot go back into the forest.\n"
"The elves would slaughter us at their leisure.\n"
"\n"
"Drakes!\n"
"Clear the area!\n"
"We must earn our rest."
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:270
msgid "NOTE: You will not be able to recall during this scenario; rather your veterans will slowly emerge from the forest."
msgstr ""

#. [message]: speaker=elf_messenger
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:466
msgid "Drakes! Your safe passage has ended; any who return to this forest will be killed!"
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:551
msgid ""
"We are traveling as fast as we can.\n"
"However the forest is slowing us.\n"
"It may be some time before the whole flight can arrive."
msgstr ""

#. [message]
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:560
msgid "We are traveling as fast as we can, however the forest is slowing us down. It may be some time before the rest of us can arrive."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:578
msgid "This land is becoming colder by the hour!"
msgstr ""

#. [message]: speaker=unit
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:597
msgid "The cold is seeping through my scales and chilling my breath!"
msgstr ""

#. [message]: speaker=narrator
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:602
msgid "NOTE: Your drakes' fire breath attacks will gradually weaken throughout the course of this scenario."
msgstr ""

#. [message]: speaker=Buk Shuurb
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:737
msgid "Lizard! GET! IN! MY! BELLY! NOW!!!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:745
msgid ""
"We have defeated the orcs and their pet trolls!\n"
"The stragglers flee already.\n"
"I doubt they will find refuge in the forest or the chill."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:757
msgid ""
"Drakes!\n"
"We shall gather around the camp and await the rest of our flight.\n"
"Then we warm ourselves, make good our wounds and leave these lands!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:766
msgid ""
"Drakes!\n"
"We are together again as a flight.\n"
"Today we rest, warm ourselves, and make good our wounds.\n"
"Tomorrow we leave these lands!"
msgstr ""

#. [message]: role=freezing_drake
#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:793
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:800
msgid ""
"So cold...\n"
"My internal fire is fading..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:807
msgid ""
"We must clear the area and return to shelter quickly.\n"
"Lest we freeze to death!"
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/scenarios/10b_Freezing_Foothills.cfg:816
msgid ""
"Already the last of my fire is flickering.\n"
"We cannot press on through the cold.\n"
"We are doomed!"
msgstr ""

