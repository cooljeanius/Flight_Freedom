#. [unit_type]: id=Drake Guard, race=drake
#: Flight_Freedom/units/drakes/Guard.cfg:5
msgid "Drake Guard"
msgstr ""

#. [unit_type]: id=Drake Guard, race=drake
#: Flight_Freedom/units/drakes/Guard.cfg:19
msgid "Protected by their massive ceramic shields, Drake Guards are responsible for the protection of more important drakes. Only three Drake flights actively raise Guards, the Kakatars being one of them."
msgstr ""

#. [unit_type]: id=Drake Hatchling, race=drake
#: Flight_Freedom/units/drakes/Hatchling.cfg:5
msgid "Drake Hatchling"
msgstr ""

#. [unit_type]: id=Drake Hatchling, race=drake
#: Flight_Freedom/units/drakes/Hatchling.cfg:21
msgid "Hatchling is a general term applied to all young drakes who have lived for less than one full breeding cycle. Although not trained in the use of weapons, Hatchlings are nontheless capable fighters, biting and slashing with no less bravery than a full-grown warrior."
msgstr ""

#. [unit_type]: id=Drake High Magus, race=drake
#: Flight_Freedom/units/drakes/High_Magus.cfg:6
msgid "Drake High Magus"
msgstr ""

#. [unit_type]: id=Drake High Magus, race=drake
#: Flight_Freedom/units/drakes/High_Magus.cfg:20
msgid "The Drake High Magi are elite members of an order of magic-using drakes who spend their days in the Obsidian Citadel, honing their powers for use in times of crisis. They can summon blasts of intense cold with a gesture, and can hurl powerful fireballs across great distances. However, due to the extensive mutilations that are required of drakes to harness and use these powers, they are frail and slow."
msgstr ""

