#. [message]: speaker=Theracar
#: Flight_Freedom/macros/deaths.cfg:134
msgid ""
"Aaarr!\n"
"My arm!"
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/macros/deaths.cfg:139
msgid ""
"Intendant!\n"
"Pull back!\n"
"I need you alive!"
msgstr ""

#. [message]: speaker=Kogw
#: Flight_Freedom/macros/deaths.cfg:146
msgid "I might be able to patch you up, mate, just don't get hurt any worse."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/macros/deaths.cfg:150
msgid "I may never fight again..."
msgstr ""

#. [message]: speaker=Theracar
#: Flight_Freedom/macros/deaths.cfg:161
msgid ""
"Aaarr!\n"
"I have failed..."
msgstr ""

#. [message]: speaker=Malakar
#: Flight_Freedom/macros/deaths.cfg:184
